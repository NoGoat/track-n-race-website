# Cloudflare static asset headers (https://developers.cloudflare.com/workers/static-assets/headers/)
# Anything not listed (HTML, the .tnrd SVGs, licenses) keeps Cloudflare's default:
# browsers re-check every load and get a cheap 304 when nothing changed.
# Keep these patterns from overlapping: if two rules match, their Cache-Control values are merged.

# Every response: no MIME sniffing, no framing by other sites, HTTPS only for a year, only the site (not the page)
# in the Referer sent to other sites, and no camera, microphone, location or the like.
# Same-site requests keep the full Referer, which worker/index.js reads for the page a download came from.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Strict-Transport-Security: max-age=31536000
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), bluetooth=(), hid=()

# Styles and scripts built by Astro: their names carry a hash of their content, so a changed file gets a new name
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Fonts never change in place; rename the file if one is ever replaced
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Images: a week without re-checking, then up to 30 more days served from cache while refreshing in the background.
# A replaced image can take up to a week to reach returning visitors.
/assets/screenshots/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

/assets/icons/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

/assets/og-image.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

/favicon.ico
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

/favicon-48x48.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

/apple-touch-icon.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
