---
// The 1.7.0 Analysis page as a guided tour. The window below is a copy of the app's Analysis screen, built from its
// React components, classes and react-select (components/analysis/), fed by two real race recordings
// (src/assets/analysis-tour/, exported from libtnrp's analysis calls). It opens empty and builds itself.
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { pages } from '../data/pages';
import TourGate from '../components/analysis/TourGate';
import { TOUR_VIDEO } from '../components/analysis/video';
import '../styles/pages/analysis.css';
---
<Base bodyClass="tour-page">
    <Fragment slot="head">
        <PageHead page={pages.analysis} />
    </Fragment>

    <main id="main" class="tour">
        <h1 class="visually-hidden">Track N Race 1.7.0: the new Analysis map</h1>
        <!-- Without JavaScript: a recording of the run, in <noscript> so pages with JavaScript only download it when
             TourGate plays it instead of the demo. Its sources are in components/analysis/video.ts. -->
        <!-- TODO: Remember to update the video before the site goes live with the final version of the Analysis screen-->
        <noscript>
            <video class="tour-video" poster={TOUR_VIDEO.poster}
                width={TOUR_VIDEO.width} height={TOUR_VIDEO.height} autoplay muted loop playsinline
                aria-label={TOUR_VIDEO.label}>
                {TOUR_VIDEO.sources.map(source => <source {...source} />)}
            </video>
            <p class="tour-nojs">A recording of the Analysis screen of Track N Race 1.7.0. Turn on JavaScript to use it yourself.</p>
        </noscript>

        <div class="js-only">
            <TourGate client:only="react" />
        </div>
    </main>
</Base>
