---
import Base from '../layouts/Base.astro';
import '../styles/pages/error.css';
---
<Base>
    <Fragment slot="head">
        <!-- Primary Meta Tags -->
        <title>404 — Page Not Found | Track N Race</title>
        <meta name="description" content="The page you were looking for could not be found on Track N Race.">
        <meta name="robots" content="noindex, follow">
        <meta name="theme-color" content="#09090b">
        <meta name="application-name" content="Track N Race">
        <meta name="apple-mobile-web-app-title" content="Track N Race">
    </Fragment>

    <main>
        <section class="section error-section">
            <div class="error-container">
                <span class="error-code">404</span>
                <h1 class="main-title">Off-Track <span class="gradient-text">Warning</span></h1>
                <p class="subtitle">
                    You went off the track. The page you requested doesn't exist or has moved to a different circuit.
                </p>
                <div class="cta-group">
                    <a href="/" data-astro-prefetch class="primary-btn">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                            <polyline points="9 22 9 12 15 12 15 22"></polyline>
                        </svg>
                        <span>Return to Pits</span>
                    </a>
                </div>
            </div>
        </section>
    </main>
</Base>
