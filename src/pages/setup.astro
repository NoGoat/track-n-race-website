---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { pages } from '../data/pages';
import '../styles/pages/setup.css';
import { icon, questions } from '../data/setup';
import SetupResult from '../components/SetupResult.astro';
import { pad } from '../data/format';
import OptionContent from '../components/OptionContent.astro';

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "@id": "https://track-n-race.com/setup/#breadcrumb",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://track-n-race.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Setup Guide",
          "item": "https://track-n-race.com/setup/"
        }
      ]
    },
    {
      "@type": "HowTo",
      "@id": "https://track-n-race.com/setup/#howto",
      "about": {
        "@type": "SoftwareApplication",
        "@id": "https://track-n-race.com/#software",
        "name": "Track N Race"
      },
      "name": "How to Setup UDP Telemetry in F1 Games for Track N Race",
      "description": "Step-by-step instructions to configure UDP telemetry in F1 24, F1 25, and 2026 Season Pack for Track N Race on a PC, a second computer, or an Android phone or tablet.",
      "totalTime": "PT3M",
      "supply": [
        {
          "@type": "HowToSupply",
          "name": "Track N Race for Windows, macOS, Linux or Android"
        },
        {
          "@type": "HowToSupply",
          "name": "F1 24, F1 25, or 2026 Season Pack Game (PC, PlayStation, or Xbox)"
        }
      ],
      "step": [
        {
          "@type": "HowToStep",
          "position": 1,
          "name": "Turn On Telemetry",
          "text": "Open F1 Game Settings -> Telemetry Settings, and toggle UDP Telemetry to On. Set UDP Send Rate between 10Hz and 60Hz."
        },
        {
          "@type": "HowToStep",
          "position": 2,
          "name": "Set Protocol Format",
          "text": "Select the latest UDP format supported by your game version (2026, 2025, or 2024)."
        },
        {
          "@type": "HowToStep",
          "position": 3,
          "name": "Set UDP Port",
          "text": "Configure UDP Port to match Track N Race application (default is 20777)."
        },
        {
          "@type": "HowToStep",
          "position": 4,
          "name": "Configure UDP IP Address",
          "text": "For playing on the same PC, enter 127.0.0.1. For a console or a second computer, enter the local IP address of the computer running Track N Race. For Track N Race on Android in Direct mode, enter the phone's Wi-Fi IP address."
        },
        {
          "@type": "HowToStep",
          "position": 5,
          "name": "Pair an Android phone (optional)",
          "text": "To mirror a desktop onto Android, open Settings -> Paired Devices on the desktop, enable paired mode and select Pair a device, then in the Android app open Settings -> Pair a desktop and scan the QR code or enter the matching code."
        }
      ]
    }
  ]
};

---
<Base jsonLd={jsonLd} nojs="/no-js/setup/">
    <Fragment slot="head">
        <PageHead page={pages.setup} />
    </Fragment>

    <main id="main">
        <div class="setup-container">
            <!-- Header Section -->
            <div class="page-header">
                <h1 class="main-title" set:html={pages.setup.heading} />
                <p class="subtitle">{pages.setup.intro}</p>
            </div>

            <!-- Questionnaire (scripts/setup.js). Without JavaScript the layout's noscript refresh opens /no-js/setup/, which
                 has a page per set of answers. -->
            <form class="setup-quiz" id="setupQuiz" aria-label="Your setup">
                {questions.map((q, i) => (
                    <fieldset class="quiz-question" data-when={q.when}>
                        <legend class="quiz-legend">
                            <span class="quiz-num">{pad(i + 1)}</span>
                            <span class="quiz-title">{q.title}</span>
                        </legend>
                        <div class="quiz-options" data-count={q.options.length}>
                            {q.options.map(o => (
                                <label class="quiz-option">
                                    <input type="radio" name={q.name} value={o.value} />
                                    <OptionContent label={o.label} desc={o.desc} icon={o.icon} />
                                </label>
                            ))}
                        </div>
                    </fieldset>
                ))}
            </form>

            <!-- Your setup: shown once every question that applies is answered (components/SetupResult.astro) -->
            <SetupResult />
        </div>
        <!-- Copy results, read out by screen readers (scripts/setup.js) -->
        <p class="visually-hidden" id="copyStatus" role="status"></p>
    </main>


    <script>
        import '../scripts/setup.js';
    </script>
</Base>
