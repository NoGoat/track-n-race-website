---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { pages } from '../data/pages';
import '../styles/pages/download.css';
import DownloadNext from '../components/DownloadNext.astro';
import DiveBody from '../components/DiveBody.astro';
import DownloadHeader from '../components/DownloadHeader.astro';
import { platforms, platformQuestion, dives } from '../data/downloads';
import OptionContent from '../components/OptionContent.astro';

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "@id": "https://track-n-race.com/download/#breadcrumb",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://track-n-race.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Download",
          "item": "https://track-n-race.com/download/"
        }
      ]
    },
    {
      "@type": "WebPage",
      "@id": "https://track-n-race.com/download/#about",
      "about": {
        "@type": "SoftwareApplication",
        "@id": "https://track-n-race.com/#software",
        "name": "Track N Race"
      },
      "name": "Download Track N Race — Electron, Native or Minimal Recorder",
      "description": "Download Track N Race for Windows, macOS, Linux or Android. Pick your platform for a short guide to the Electron, Native and Minimal Recorder builds, then download the one that suits your setup.",
      "isPartOf": {
        "@type": "WebSite",
        "@id": "https://track-n-race.com/#website",
        "name": "Track N Race",
        "url": "https://track-n-race.com/"
      },
      "breadcrumb": { "@id": "https://track-n-race.com/download/#breadcrumb" }
    }
  ]
};
---
<Base jsonLd={jsonLd} nojs="/no-js/download/">
    <Fragment slot="head">
        <PageHead page={pages.download} />
    </Fragment>

    <main id="main">
        <!-- Download: pick a platform, read a short guide to its builds and download one, then the Setup link.
             The full comparison (table and screen by screen) is the Frontends page, /electron-vs-qt/. -->
        <section id="download" class="section download-section">
            <DownloadHeader />

            <!-- scripts/download-page.js. Without JavaScript the layout's noscript refresh opens /no-js/download/; the
                 note below links there too, for browsers that block refreshes. -->
            <div class="dl-flow" id="downloadFlow">
                <fieldset class="quiz-question">
                    <legend class="quiz-legend">
                        <span class="quiz-num">01</span>
                        <span class="quiz-title">{platformQuestion}</span>
                    </legend>
                    <div class="quiz-options" data-count="4">
                        {platforms.map(p => (
                            <label class="quiz-option" data-os={p.os}>
                                <input type="radio" name="platform" value={p.os} />
                                <OptionContent label={p.label} desc={p.desc} icon={p.icon} />
                            </label>
                        ))}
                    </div>
                </fieldset>

                {dives.map(dive => (
                    <section class="quiz-question dl-dive" data-for={dive.for.join(' ')} hidden>
                        <div class="quiz-legend">
                            <span class="quiz-num">02</span>
                            <h2 class="quiz-title">{dive.title}</h2>
                        </div>
                        <DiveBody dive={dive} oses={dive.for} />
                    </section>
                ))}
            </div>

            <!-- The end of the flow: always shown, and says which download started once one is clicked -->
            <noscript>
                <p class="dl-note">
                    The guide needs JavaScript. <a href="/no-js/download/">Use the version without it</a> instead.
                </p>
            </noscript>

            <DownloadNext heading="h2" class="dl-next" />
        </section>
    </main>

    <script>
        import '../scripts/download-page.js';
    </script>
</Base>
