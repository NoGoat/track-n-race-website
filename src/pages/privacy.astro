---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { pages } from '../data/pages';
import '../styles/pages/privacy.css';
import PrivacyBody from '../components/PrivacyBody.astro';

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "@id": "https://track-n-race.com/privacy/#breadcrumb",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://track-n-race.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Privacy Policy",
          "item": "https://track-n-race.com/privacy/"
        }
      ]
    },
    {
      "@type": "WebPage",
      "@id": "https://track-n-race.com/privacy/#webpage",
      "url": "https://track-n-race.com/privacy/",
      "name": "Privacy Policy — Track N Race Android App, Desktop App & Website",
      "description": "Privacy Policy for the Track N Race Android app, Desktop app and website describing how they handle telemetry data, device permissions, local storage, update checks, website download counts, and user privacy.",
      "inLanguage": "en-US",
      "dateModified": "2026-10-26",
      "isPartOf": { "@id": "https://track-n-race.com/#website" }
    }
  ]
};
---
<Base jsonLd={jsonLd} nojs="/no-js/privacy/">
    <Fragment slot="head">
        <PageHead page={pages.privacy} />
    </Fragment>

    <PrivacyBody />
</Base>
