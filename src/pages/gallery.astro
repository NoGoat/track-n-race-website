---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { pages } from '../data/pages';
import '../styles/pages/gallery.css';
import Lightbox from '../components/Lightbox.astro';
import GalleryShot from '../components/GalleryShot.astro';
import ScreenPicture from '../components/ScreenPicture.astro';
import { groups } from '../data/gallery';
import { screens } from '../data/screens';


const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "@id": "https://track-n-race.com/gallery/#breadcrumb",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://track-n-race.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Gallery",
          "item": "https://track-n-race.com/gallery/"
        }
      ]
    },
    {
      "@type": "WebPage",
      "@id": "https://track-n-race.com/gallery/#about",
      "about": {
        "@type": "SoftwareApplication",
        "@id": "https://track-n-race.com/#software",
        "name": "Track N Race"
      },
      "name": "Gallery — Track N Race",
      "description": "Every screen of Track N Race in the Electron and Native frontends and the Android app: overview, inputs, power, damage, tyres, standings, strategy, lap analysis and trends.",
      "isPartOf": {
        "@type": "WebSite",
        "@id": "https://track-n-race.com/#website",
        "name": "Track N Race",
        "url": "https://track-n-race.com/"
      },
      "breadcrumb": { "@id": "https://track-n-race.com/gallery/#breadcrumb" }
    }
  ]
};
---
<Base jsonLd={jsonLd}>
    <Fragment slot="head">
        <PageHead page={pages.gallery} />
    </Fragment>

    <main id="main" class="gallery-section">
        <!-- Gallery: every screen, in area order. The switch shows each one in the Electron or the Qt frontend
             or the Android app; every capture sits in the markup, and a hidden one's lazy images don't load until
             it is picked. Screens the Android app doesn't have are left out of its tab. The switch is a radio group
             that styles/gallery.css follows, so it works without JavaScript too. -->

        <!-- Sticky header. At rest its rule matches the content column; once it sticks under the navbar
             (scripts/sticky-bar.js adds .is-stuck) it runs edge to edge with the navbar's background, border and shadow. -->
        <div class="gallery-head">
            <div class="gallery-head-inner">
                <h1 class="main-title">Gallery</h1>
                <!-- Same tabs as the Setup page's Single PC / Dual System selector -->
                <!-- autocomplete off: a reload starts on Electron (or the URL's pick) instead of the last one checked -->
                <div class="scenario-selector gallery-switch" role="radiogroup" aria-label="Frontend">
                    <label class="scenario-btn gallery-switch-btn"><input type="radio" name="ui" id="ui-electron" value="electron" autocomplete="off" checked>Electron</label>
                    <label class="scenario-btn gallery-switch-btn"><input type="radio" name="ui" id="ui-qt" value="qt" autocomplete="off">Native</label>
                    <label class="scenario-btn gallery-switch-btn"><input type="radio" name="ui" id="ui-android" value="android" autocomplete="off">Android</label>
                </div>
            </div>
        </div>

        <!-- Viewer: one screen at a time, big, with its caption beside it, and a strip of every screen by area under
             it (scripts/gallery.js). Without JavaScript the strip is left out and every screen is listed in turn. -->
        <section id="gallery" class="section gallery-body" aria-label="Screens">
            <div class="viewer-stage" id="viewerStage">
                {groups.map((group, g) => group.screens.map((file, i) => (
                    <GalleryShot file={file} group={group.title} current={g === 0 && i === 0} lazy={g > 0 || i > 0} />
                )))}
            </div>
            <p class="visually-hidden" id="viewerStatus" aria-live="polite"></p>

            <nav class="viewer-strip" aria-label="Every screen">
                {groups.map(group => (
                    <div class="strip-group">
                        <span class="strip-title">{group.title}</span>
                        <ul class="strip-thumbs">
                            {group.screens.map((file, i) => {
                                const screen = screens[file];
                                return (
                                    <li class:list={{ 'no-android': !screen.android }}>
                                        <a class:list={['strip-thumb', { active: group === groups[0] && i === 0, 'shot-trimmed': screen.width === 2492 }]}
                                            href={`#shot-${file}`} data-file={file} aria-current={group === groups[0] && i === 0 ? 'true' : undefined}>
                                            <span class="thumb-frame" aria-hidden="true">
                                                <ScreenPicture screen={screen} ui="electron" sizes="104px" lazy />
                                                <ScreenPicture screen={screen} ui="qt" sizes="104px" lazy />
                                                {screen.android && <ScreenPicture screen={screen} ui="android" sizes="104px" lazy />}
                                            </span>
                                            <span class:list={['visually-hidden', { 'desc-desktop': screen.android?.name }]}>{screen.name}</span>
                                            {screen.android?.name && <span class="visually-hidden" data-ui="android">{screen.android.name}</span>}
                                        </a>
                                    </li>
                                );
                            })}
                        </ul>
                    </div>
                ))}
            </nav>
        </section>
    </main>

    <Lightbox slot="after-footer" />

    <script>
        import '../scripts/sticky-bar.js';
        import '../scripts/gallery.js';
    </script>
</Base>
