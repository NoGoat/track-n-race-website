---
// The Download page without JavaScript: /download/ sends browsers here from a noscript refresh. Every platform's guide
// at once, from the same data (data/downloads.ts), with real download links. Not indexed: /download/ is the page.
// It sits under /download/, so it passes through worker/index.js, which hands any path that isn't a build to the assets.
import Base from '../../layouts/Base.astro';
import '../../styles/pages/download.css';
import DownloadNext from '../../components/DownloadNext.astro';
import BuildCard from '../../components/BuildCard.astro';
import { platforms, dives } from '../../data/downloads';

const sections = platforms.map(p => ({ ...p, dive: dives.find(d => d.for.includes(p.os))! }));
const pad = (n: number) => String(n).padStart(2, '0');
---
<Base>
    <Fragment slot="head">
        <title>Download Track N Race — Every build</title>
        <meta name="description"
            content="Every Track N Race build for Windows, macOS, Linux and Android on one page: Electron, Native and the Minimal Recorder.">
        <meta name="robots" content="noindex, follow">
        <meta name="author" content="NoGoat">
        <meta name="application-name" content="Track N Race">
        <meta name="apple-mobile-web-app-title" content="Track N Race">
        <meta name="theme-color" content="#09090b">
        <link rel="canonical" href="https://track-n-race.com/download/">
    </Fragment>

    <main id="main">
        <section id="download" class="section download-section">
            <div class="page-header">
                <h1 class="main-title">Download Track N Race</h1>
                <p class="subtitle">
                    Every build for every platform, on one page. Free and open source, or
                    <a href="/electron-vs-qt/">compare the frontends</a> screen by screen.
                </p>
            </div>

            <div class="dl-flow">
                <nav class="quiz-question" aria-label="Platforms">
                    <div class="quiz-legend">
                        <span class="quiz-title">Jump to your platform</span>
                    </div>
                    <div class="quiz-options" data-count="4">
                        {platforms.map(p => (
                            <a class="quiz-option dl-jump" href={`#${p.os}`}>
                                <span class="quiz-option-icon" set:html={p.icon} />
                                <span class="quiz-option-text">
                                    <span class="quiz-option-label">{p.label}</span>
                                    <span class="quiz-option-desc">{p.desc}</span>
                                </span>
                            </a>
                        ))}
                    </div>
                </nav>

                {sections.map((s, i) => (
                    <section class="quiz-question dl-dive" id={s.os} aria-labelledby={`${s.os}-title`}>
                        <div class="quiz-legend">
                            <span class="quiz-num">{pad(i + 1)}</span>
                            <h2 class="quiz-title dl-platform-title" id={`${s.os}-title`}>
                                <span class="quiz-option-icon" set:html={s.icon} />
                                <span>{s.label}</span>
                            </h2>
                        </div>
                        <div class="dl-dive-body">
                            <p class="dl-intro">{s.dive.intro}</p>
                            <div class="dl-builds" data-count={s.dive.builds.length}>
                                {s.dive.builds.map(build => <BuildCard build={build} oses={[s.os]} staticLinks />)}
                            </div>
                            {s.dive.advice && <p class="dl-advice">{s.dive.advice}</p>}
                            {s.dive.ramNote && (
                                <p class="dl-note">
                                    RAM measured on Windows 11 over a 92-minute race. How, and every figure, on the
                                    <a href="/electron-vs-qt/#at-a-glance">Frontends page</a>.
                                </p>
                            )}
                        </div>
                    </section>
                ))}
            </div>

            <DownloadNext heading="h2" class="dl-next" />
        </section>
    </main>
</Base>
