---
// The home page without JavaScript (data/nojs.ts): / sends browsers here from a noscript refresh. The same content
// (components/HomeBody.astro), with every carousel slide listed and no lightbox. Not indexed: / is the page.
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import { pages } from '../../data/pages';
import '../../styles/pages/home.css';
import HomeBody from '../../components/HomeBody.astro';
---
<Base>
    <Fragment slot="head">
        <PageHead page={pages.home} nojs />
    </Fragment>

    <HomeBody nojs />
</Base>
