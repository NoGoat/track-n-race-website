---
// The Setup page without JavaScript (data/nojs.ts): /setup/ sends browsers here from a noscript refresh. A page per
// set of answers (data/setup-paths.ts), each answer a link to the next one, and once every question that applies is
// answered, the same result the Setup page shows for them (components/SetupResult.astro). Not indexed: /setup/ is
// the page.
import Base from '../../../layouts/Base.astro';
import PageHead from '../../../components/PageHead.astro';
import { pages } from '../../../data/pages';
import '../../../styles/pages/setup.css';
import SetupResult from '../../../components/SetupResult.astro';
import { derive, type Answers } from '../../../data/setup-logic';
import { allAnswerSets, pathOf, fromPath, shownQuestions, hrefWith } from '../../../data/setup-paths';
import { pad } from '../../../data/format';
import OptionContent from '../../../components/OptionContent.astro';

export function getStaticPaths() {
    return allAnswerSets().map(a => ({ params: { answers: pathOf(a) || undefined } }));
}

const answers: Answers = fromPath(Astro.params.answers);
const state = derive(answers);
const shown = shownQuestions(answers);
const complete = state.complete === 'yes';
---
<Base>
    <Fragment slot="head">
        <PageHead page={pages.setup} nojs />
    </Fragment>

    <main id="main">
        <div class="setup-container">
            <div class="page-header">
                <h1 class="main-title" set:html={pages.setup.heading} />
                <p class="subtitle">{pages.setup.intro}</p>
            </div>

            <!-- Each answer is a link to the page with it added; the picked one is marked -->
            <div class="setup-quiz" aria-label="Your setup">
                {shown.map((q, i) => (
                    <section class="quiz-question" id={`q-${q.name}`} aria-labelledby={`q-${q.name}-title`}>
                        <div class="quiz-legend">
                            <span class="quiz-num">{pad(i + 1)}</span>
                            <h2 class="quiz-title" id={`q-${q.name}-title`}>{q.title}</h2>
                        </div>
                        <div class="quiz-options" data-count={q.options.length}>
                            {q.options.map(o => {
                                const picked = answers[q.name as keyof Answers] === o.value;
                                return (
                                    <a class:list={['quiz-option', { 'is-selected': picked }]} href={hrefWith(answers, q.name, o.value)}
                                        aria-current={picked ? 'true' : undefined}>
                                        <OptionContent label={o.label} desc={o.desc} icon={o.icon} />
                                    </a>
                                );
                            })}
                        </div>
                    </section>
                ))}
            </div>

            {complete && (
                <SetupResult state={state} answerHref={(name, value) => hrefWith(answers, name, value)} restartHref="/no-js/setup/" />
            )}
        </div>
    </main>
</Base>
