---
// The Frontends page without JavaScript (data/nojs.ts): /electron-vs-qt/ sends browsers here from a noscript refresh.
// The same table (components/CompareTable.astro), then every screen with Electron and Native side by side instead
// of the tabs and the slider. Not indexed: /electron-vs-qt/ is the page.
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import { pages } from '../../data/pages';
import '../../styles/pages/compare.css';
import CompareDownload from '../../components/CompareDownload.astro';
import CompareTable from '../../components/CompareTable.astro';
import { screens } from '../../data/screens';
import { order } from '../../data/compare';
import { pad } from '../../data/format';

---
<Base>
    <Fragment slot="head">
        <PageHead page={pages.compare} nojs />
    </Fragment>

    <main id="main">
        <section id="compare" class="section compare-section">
            <div class="page-header">
                <h1 class="main-title">{pages.compare.heading}</h1>
                <p class="subtitle">{pages.compare.intro}</p>
            </div>

            <CompareTable />

            <div class="section-header compare-sliders-header">
                <h2 class="section-heading">Screen by screen</h2>
                <span class="eyebrow">{pad(order.length)} screens</span>
            </div>

            <div class="compare-static-list">
                {order.map((file, i) => {
                    const screen = screens[file];
                    // Only the first screen loads straight away
                    const loading = i === 0 ? undefined : 'lazy';
                    return (
                        <section aria-labelledby={`screen-${file}`}>
                            <div class="compare-static-title">
                                <span class="module-num">{pad(i + 1)}</span>
                                <h3 class="module-title" id={`screen-${file}`}>{screen.name}</h3>
                            </div>
                            <div class="compare-static-pair">
                                <figure class="compare-static-side">
                                    <figcaption class="compare-tag">Electron</figcaption>
                                    <img src={`/assets/screenshots/${file}.webp`} alt={`Electron frontend: ${screen.name}`}
                                        width={screen.width} height={screen.height} loading={loading}>
                                </figure>
                                <figure class="compare-static-side">
                                    <figcaption class="compare-tag">Native</figcaption>
                                    <img src={`/assets/screenshots/qt/${file}.webp`} alt={`Native frontend: ${screen.name}`}
                                        width={screen.width} height={screen.height} loading={loading}>
                                </figure>
                            </div>
                        </section>
                    );
                })}
            </div>

            <CompareDownload />
        </section>
    </main>
</Base>
