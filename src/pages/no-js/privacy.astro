---
// The Privacy Policy without JavaScript (data/nojs.ts): /privacy/ sends browsers here from a noscript refresh. The same
// text (components/PrivacyBody.astro). Not indexed: /privacy/ is the page.
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import { pages } from '../../data/pages';
import '../../styles/pages/privacy.css';
import PrivacyBody from '../../components/PrivacyBody.astro';
---
<Base>
    <Fragment slot="head">
        <PageHead page={pages.privacy} nojs />
    </Fragment>

    <PrivacyBody />
</Base>
