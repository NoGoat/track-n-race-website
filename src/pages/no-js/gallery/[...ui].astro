---
// The Gallery without JavaScript (data/nojs.ts): /gallery/ sends browsers here from a noscript refresh. A page per
// frontend instead of the switch, which is links between them, and only that frontend's screenshots in the page.
// The same groups, numbers and captions as the Gallery (data/gallery.ts), and its stylesheet: data-ui on <main>
// picks the captions as the switch does there. Not indexed: /gallery/ is the page.
import Base from '../../../layouts/Base.astro';
import PageHead from '../../../components/PageHead.astro';
import { pages } from '../../../data/pages';
import '../../../styles/pages/gallery.css';
import GalleryShot from '../../../components/GalleryShot.astro';
import { screens } from '../../../data/screens';
import { groups, androidCount } from '../../../data/gallery';
import { pad } from '../../../data/format';

type Ui = 'electron' | 'qt' | 'android';
const UIS: { ui: Ui; slug?: string; label: string }[] = [
    { ui: 'electron', label: 'Electron' },
    { ui: 'qt', slug: 'native', label: 'Native' },
    { ui: 'android', slug: 'android', label: 'Android' },
];

export function getStaticPaths() {
    return [{ params: { ui: undefined } }, { params: { ui: 'native' } }, { params: { ui: 'android' } }];
}

const current = UIS.find(u => u.slug === Astro.params.ui)!;
const hrefOf = (slug?: string) => `/no-js/gallery/${slug ? slug + '/' : ''}`;
const isAndroid = current.ui === 'android';
---
<Base>
    <Fragment slot="head">
        <PageHead page={pages.gallery} nojs />
    </Fragment>

    <main id="main" class="gallery-section" data-ui={current.ui}>
        <div class="gallery-head">
            <div class="gallery-head-inner">
                <h1 class="main-title">Gallery</h1>
                <nav class="scenario-selector gallery-switch" aria-label="Frontend">
                    {UIS.map(u => (
                        <a class:list={['scenario-btn', 'gallery-switch-btn', { active: u === current }]} href={hrefOf(u.slug)}
                            aria-current={u === current ? 'page' : undefined}>{u.label}</a>
                    ))}
                </nav>
            </div>
        </div>

        <section id="gallery" class="section gallery-body">
            {groups.map((group, g) => (
                <section class="gallery-group" aria-labelledby={group.id}>
                    <div class="section-header">
                        <h2 class="section-heading" id={group.id}>{group.title}</h2>
                        <span class="eyebrow">{pad(isAndroid ? androidCount(group.screens) : group.screens.length)} screens</span>
                    </div>
                    <div class="gallery-grid">
                        {group.screens.filter(file => !isAndroid || screens[file].android).map(file => <GalleryShot file={file} lazy={g > 0} ui={current.ui} />)}
                    </div>
                </section>
            ))}
        </section>
    </main>
</Base>
