---
import Base from '../layouts/Base.astro';
import '../styles/pages/credits.css';

// The library browser's projects, by stack. file is the license text in /assets/licenses/.
const libraries = [
    {
        stack: 'core',
        title: 'Core',
        items: [
            { name: 'zlib', spdx: 'Zlib', file: 'Zlib.txt', href: 'https://zlib.net' },
            { name: 'Zstandard', spdx: 'BSD-3-Clause', file: 'zstandard.txt', href: 'https://facebook.github.io/zstd/' },
            { name: 'glaze', spdx: 'MIT', file: 'glaze.txt', href: 'https://github.com/stephenberry/glaze' },
            { name: 'libxlsxwriter', spdx: 'BSD-2-Clause', file: 'libxlsxwriter.txt', href: 'https://libxlsxwriter.github.io' },
        ],
    },
    {
        stack: 'electron',
        title: 'Electron',
        items: [
            { name: 'Electron', spdx: 'MIT', file: 'electron.txt', href: 'https://electronjs.org' },
            { name: 'React', spdx: 'MIT', file: 'react.txt', href: 'https://react.dev' },
            { name: 'React DOM', spdx: 'MIT', file: 'react-dom.txt', href: 'https://react.dev' },
            { name: 'electron-store', spdx: 'MIT', file: 'electron-store.txt', href: 'https://github.com/sindresorhus/electron-store' },
            { name: 'lucide-react', spdx: 'ISC', file: 'lucide-react.txt', href: 'https://lucide.dev' },
            { name: 'react-select', spdx: 'MIT', file: 'react-select.txt', href: 'https://react-select.com' },
            { name: '@uiw/react-color', spdx: 'MIT', file: 'uiw-react-color.txt', href: 'https://github.com/uiwjs/react-color' },
            { name: 'zustand', spdx: 'MIT', file: 'zustand.txt', href: 'https://zustand.docs.pmnd.rs/' },
            { name: 'TimeChart', spdx: 'MIT', file: 'timechart.txt', href: 'https://github.com/huww98/TimeChart' },
            { name: 'd3-axis', spdx: 'ISC', file: 'd3-axis.txt', href: 'https://d3js.org/d3-axis/' },
            { name: 'd3-color', spdx: 'ISC', file: 'd3-color.txt', href: 'https://d3js.org/d3-color/' },
            { name: 'd3-scale', spdx: 'ISC', file: 'd3-scale.txt', href: 'https://d3js.org/d3-scale/' },
            { name: 'd3-selection', spdx: 'ISC', file: 'd3-selection.txt', href: 'https://d3js.org/d3-selection/' },
            { name: 'gl-matrix', spdx: 'MIT', file: 'gl-matrix.txt', href: 'https://glmatrix.net/' },
            { name: 'tslib', spdx: '0BSD', file: 'tslib.txt', href: 'https://github.com/microsoft/tslib' },
            { name: 'Cascadia Code', spdx: 'OFL-1.1', file: 'cascadia-code.txt', href: 'https://github.com/microsoft/cascadia-code' },
            { name: 'node-addon-api', spdx: 'MIT', file: 'node-addon-api.txt', href: 'https://github.com/nodejs/node-addon-api' },
        ],
    },
    {
        stack: 'qt',
        title: 'Native',
        items: [
            { name: 'Qt', spdx: 'LGPL-3.0', file: 'LGPL-3.0.txt', href: 'https://www.qt.io' },
            { name: 'qt-toast (fork)', spdx: 'MIT', file: 'MIT-qt-toast.txt', href: 'https://github.com/niklashenning/qt-toast' },
            { name: 'Noto Sans', spdx: 'OFL-1.1', file: 'OFL-1.1-Noto.txt', href: 'https://fonts.google.com/noto/specimen/Noto+Sans' },
            { name: 'Breeze style (Plasma)', spdx: 'GPL-2.0', file: 'GPL-2.0.txt', href: 'https://invent.kde.org/plasma/breeze' },
            { name: 'Breeze Icons', spdx: 'LGPL-3.0', file: 'LGPL-3.0.txt', href: 'https://invent.kde.org/frameworks/breeze-icons' },
            { name: 'KDE Frameworks', spdx: 'LGPL-2.1', file: 'LGPL-2.1.txt', href: 'https://develop.kde.org/products/frameworks/' },
        ],
    },
];
const pad = (n: number) => String(n).padStart(2, '0');

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "@id": "https://track-n-race.com/credits/#breadcrumb",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://track-n-race.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Credits & Licensing",
          "item": "https://track-n-race.com/credits/"
        }
      ]
    },
    {
      "@type": "WebPage",
      "@id": "https://track-n-race.com/credits/#about",
      "about": {
        "@type": "SoftwareApplication",
        "@id": "https://track-n-race.com/#software",
        "name": "Track N Race"
      },
      "name": "Credits & Open Source Licensing — Track N Race",
      "description": "Open source attributions, third-party libraries, and GNU General Public License v3.0 details for Track N Race F1 Game telemetry analysis software.",
      "isPartOf": {
        "@type": "WebSite",
        "@id": "https://track-n-race.com/#website",
        "name": "Track N Race",
        "url": "https://track-n-race.com/"
      }
    }
  ]
};
---
<Base jsonLd={jsonLd} bodyClass="page-fit">
    <Fragment slot="head">
        <!-- Primary Meta Tags -->
        <title>Credits & Licensing — Track N Race</title>
        <meta name="description"
            content="Track N Race open source attributions, third-party libraries, and additional information for Web and desktop telemetry frontends.">
        <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
        <meta name="author" content="NoGoat">
        <meta name="application-name" content="Track N Race">
        <meta name="apple-mobile-web-app-title" content="Track N Race">
        <meta name="theme-color" content="#09090b">

        <!-- Open Graph / Facebook -->
        <meta property="og:type" content="article">
        <meta property="og:site_name" content="Track N Race">
        <meta property="og:locale" content="en_US">
        <meta property="og:url" content="https://track-n-race.com/credits/">
        <meta property="og:title" content="Credits & Licensing — Track N Race">
        <meta property="og:description"
            content="Track N Race open source attributions, third-party libraries, and GNU General Public License v3.0 information for Web and desktop telemetry frontends.">
        <meta property="og:image" content="https://track-n-race.com/assets/og-image.png">
        <meta property="og:image:width" content="1200">
        <meta property="og:image:height" content="630">
        <meta property="og:image:alt" content="Track N Race overview dashboard showing live speed, RPM and ERS traces with tyre temperatures">

        <!-- Twitter -->
        <meta name="twitter:card" content="summary_large_image">
        <meta name="twitter:url" content="https://track-n-race.com/credits/">
        <meta name="twitter:title" content="Credits & Licensing — Track N Race">
        <meta name="twitter:description"
            content="Track N Race open source attributions, third-party libraries, and GNU General Public License v3.0 information for Web and desktop telemetry frontends.">
        <meta name="twitter:image" content="https://track-n-race.com/assets/og-image.png">
        <meta name="twitter:image:alt" content="Track N Race overview dashboard showing live speed, RPM and ERS traces with tyre temperatures">

        <!-- Canonical URL -->
        <link rel="canonical" href="https://track-n-race.com/credits/">

        <!-- JSON-LD Structured Data -->
    </Fragment>

    <main id="main">
        <!-- Credits: open source library browser -->
        <section id="attributions" class="section attributions-section">
            <div class="attributions-container">
                <div class="page-header">
                    <h1 class="main-title">Credits</h1>
                    <p class="section-desc">
                        The following open source projects made Track N Race possible. Note that this is in no way
                        trying to
                        affiliate Track N Race with these projects. I just felt that it was appropriate to shout out
                        these projects since these helped me in creation of Track N Race.
                    </p>
                </div>

                <!-- Library browser: grouped project list beside a license reader.
                     On phones the reader is hidden and licenses open in the pop-up instead. -->
                <div class="library">
                    <nav class="library-list" aria-label="Open source projects">
                    {libraries.map((group, g) => (
                        <section class="library-group" data-stack={group.stack}>
                            <h2 class="library-group-title">{group.title} <span class="library-count">{pad(group.items.length)}</span></h2>
                            <ul class="library-items">
                                {group.items.map((item, i) => {
                                    // The first project is the one the reader opens on
                                    const first = g === 0 && i === 0;
                                    return (
                                        <li>
                                            <button class:list={['library-item', { active: first }]} aria-pressed={first ? 'true' : 'false'} aria-controls="library-reader"
                                                data-file={item.file} data-spdx={item.spdx} data-href={item.href} data-stack={group.stack}>
                                                <span class="library-name">{item.name}</span>
                                                <span class="library-spdx">{item.spdx}</span>
                                            </button>
                                        </li>
                                    );
                                })}
                            </ul>
                        </section>
                    ))}
                    </nav>

                    <article class="library-reader" id="library-reader">
                        <header class="reader-head">
                            <div class="reader-title">
                                <h3 class="reader-name">zlib</h3>
                                <p class="reader-meta"><span class="reader-stack" data-stack="core">Core</span><span class="reader-spdx">Zlib</span></p>
                            </div>
                            <a class="reader-link" href="https://zlib.net" target="_blank" rel="noopener">
                                <span>Website</span>
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                    stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M7 17 17 7"></path>
                                    <path d="M7 7h10v10"></path>
                                </svg>
                            </a>
                        </header>
                        <!-- Focusable so the keyboard can scroll the license -->
                        <pre class="reader-text" tabindex="0" role="region" aria-label="License text">Loading...</pre>
                    </article>
                </div>

                <!-- Without JavaScript the reader can't load a license, so the browser above is hidden (credits.css) and
                     every project is listed instead, its name linking to the license text -->
                <div class="library-static nojs-only">
                    {libraries.map(group => (
                        <section class="library-static-group">
                            <h2 class="library-group-title">{group.title} <span class="library-count">{pad(group.items.length)}</span></h2>
                            <ul class="library-static-items">
                                {group.items.map(item => (
                                    <li>
                                        <a class="library-name" href={`/assets/licenses/${item.file}`}>{item.name}<span class="visually-hidden"> license</span></a>
                                        <span class="library-spdx">{item.spdx}</span>
                                        <a class="library-static-site" href={item.href} target="_blank" rel="noopener">Website<span class="visually-hidden">: {item.name}</span></a>
                                    </li>
                                ))}
                            </ul>
                        </section>
                    ))}
                </div>
            </div>
        </section>
    </main>

    <script>
        import '../scripts/credits.js';
    </script>
</Base>
