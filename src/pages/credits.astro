---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { pages } from '../data/pages';
import '../styles/pages/credits.css';
import { libraries } from '../data/libraries';
import { pad } from '../data/format';


const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "@id": "https://track-n-race.com/credits/#breadcrumb",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://track-n-race.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Credits & Licensing",
          "item": "https://track-n-race.com/credits/"
        }
      ]
    },
    {
      "@type": "WebPage",
      "@id": "https://track-n-race.com/credits/#about",
      "about": {
        "@type": "SoftwareApplication",
        "@id": "https://track-n-race.com/#software",
        "name": "Track N Race"
      },
      "name": "Credits & Open Source Licensing — Track N Race",
      "description": "Open source attributions, third-party libraries, and GNU General Public License v3.0 details for Track N Race F1 Game telemetry analysis software.",
      "isPartOf": {
        "@type": "WebSite",
        "@id": "https://track-n-race.com/#website",
        "name": "Track N Race",
        "url": "https://track-n-race.com/"
      }
    }
  ]
};
---
<Base jsonLd={jsonLd} bodyClass="page-fit">
    <Fragment slot="head">
        <PageHead page={pages.credits} />
    </Fragment>

    <main id="main">
        <!-- Credits: open source library browser -->
        <section id="attributions" class="section attributions-section">
            <div class="attributions-container">
                <div class="page-header">
                    <h1 class="main-title">{pages.credits.heading}</h1>
                    <p class="section-desc">{pages.credits.intro}</p>
                </div>

                <!-- Library browser: grouped project list beside a license reader (scripts/credits.js). Each project
                     links to its license text, which the reader shows in place; without JavaScript the reader is left
                     out and the links open the text files (styles/credits.css). -->
                <div class="library">
                    <nav class="library-list" aria-label="Open source projects">
                    {libraries.map((group, g) => (
                        <section class="library-group" data-stack={group.stack}>
                            <h2 class="library-group-title">{group.title} <span class="library-count">{pad(group.items.length)}</span></h2>
                            <ul class="library-items">
                                {group.items.map((item, i) => {
                                    // The first project is the one the reader opens on
                                    const first = g === 0 && i === 0;
                                    return (
                                        <li>
                                            <a class:list={['library-item', { active: first }]} href={`/assets/licenses/${item.file}`}
                                                aria-current={first ? 'true' : undefined} aria-controls="library-reader"
                                                data-file={item.file} data-spdx={item.spdx} data-href={item.href} data-stack={group.stack}>
                                                <span class="library-name">{item.name}</span>
                                                <span class="library-spdx">{item.spdx}</span>
                                            </a>
                                        </li>
                                    );
                                })}
                            </ul>
                        </section>
                    ))}
                    </nav>

                    <article class="library-reader" id="library-reader">
                        <header class="reader-head">
                            <div class="reader-title">
                                <h3 class="reader-name">zlib</h3>
                                <p class="reader-meta"><span class="reader-stack" data-stack="core">Core</span><span class="reader-spdx">Zlib</span></p>
                            </div>
                            <a class="reader-link" href="https://zlib.net" target="_blank" rel="noopener">
                                <span>Website</span>
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                    stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M7 17 17 7"></path>
                                    <path d="M7 7h10v10"></path>
                                </svg>
                            </a>
                        </header>
                        <!-- Focusable so the keyboard can scroll the license -->
                        <pre class="reader-text" tabindex="0" role="region" aria-label="License text">Loading...</pre>
                    </article>
                </div>
            </div>
        </section>
    </main>

    <script>
        import '../scripts/credits.js';
    </script>
</Base>
