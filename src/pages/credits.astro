---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { pages } from '../data/pages';
import '../styles/pages/credits.css';
import { libraries } from '../data/libraries';
import { pad } from '../data/format';

const first = libraries[0].items[0];
// The website as a short label: host without www, plus the path for repositories
const siteLabel = (href: string) => {
    const url = new URL(href);
    return (url.host.replace(/^www\./, '') + url.pathname).replace(/\/$/, '');
};


const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "@id": "https://track-n-race.com/credits/#breadcrumb",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://track-n-race.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Credits & Licensing",
          "item": "https://track-n-race.com/credits/"
        }
      ]
    },
    {
      "@type": "WebPage",
      "@id": "https://track-n-race.com/credits/#about",
      "about": {
        "@type": "SoftwareApplication",
        "@id": "https://track-n-race.com/#software",
        "name": "Track N Race"
      },
      "name": "Credits & Open Source Licensing — Track N Race",
      "description": "Open source attributions, third-party libraries, and GNU General Public License v3.0 details for Track N Race F1 Game telemetry analysis software.",
      "isPartOf": {
        "@type": "WebSite",
        "@id": "https://track-n-race.com/#website",
        "name": "Track N Race",
        "url": "https://track-n-race.com/"
      }
    }
  ]
};
---
<Base jsonLd={jsonLd} bodyClass="page-fit">
    <Fragment slot="head">
        <PageHead page={pages.credits} />
    </Fragment>

    <main id="main">
        <!-- Credits: open source library browser -->
        <section id="attributions" class="section attributions-section">
            <div class="attributions-container">
                <div class="page-header">
                    <h1 class="main-title">{pages.credits.heading}</h1>
                    <p class="section-desc">{pages.credits.intro}</p>
                </div>

                <!-- Library browser: grouped project list beside a license reader (scripts/credits.js). Each project
                     links to its license text, which the reader shows in place; without JavaScript the reader is left
                     out and the links open the text files (styles/credits.css). On phones the stacks are tabs above
                     the list and the reader opens in a bottom sheet (the dialog below). -->
                <div class="library">
                    <!-- Phones only: one stack's list at a time. Needs the script, so without it every stack is listed. -->
                    <div class="stack-tabs js-only" role="group" aria-label="Stack">
                        {libraries.map((group, g) => (
                            <button class="stack-tab" type="button" data-stack={group.stack} aria-controls={`group-${group.stack}`}
                                aria-pressed={g === 0 ? 'true' : 'false'}>
                                {group.title} <span class="stack-tab-count">{pad(group.items.length)}</span>
                            </button>
                        ))}
                    </div>
                    <nav class="library-list" aria-label="Open source projects">
                    {libraries.map((group, g) => (
                        <section class:list={['library-group', { 'is-shown': g === 0 }]} id={`group-${group.stack}`} data-stack={group.stack}>
                            <h2 class="library-group-title"><span class="library-group-name">{group.title}</span> <span class="library-count">{pad(group.items.length)}</span></h2>
                            <p class="library-group-desc">{group.desc}</p>
                            <ul class="library-items">
                                {group.items.map((item, i) => {
                                    // The first project is the one the reader opens on
                                    const isFirst = g === 0 && i === 0;
                                    return (
                                        <li>
                                            <a class:list={['library-item', { active: isFirst }]} href={`/assets/licenses/${item.file}`}
                                                aria-current={isFirst ? 'true' : undefined} aria-controls="library-reader"
                                                data-file={item.file} data-spdx={item.spdx} data-href={item.href}
                                                data-site={siteLabel(item.href)} data-stack={group.stack} data-stack-title={group.title}>
                                                <span class="library-name">{item.name}</span>
                                                <span class="library-spdx">{item.spdx}</span>
                                            </a>
                                        </li>
                                    );
                                })}
                            </ul>
                        </section>
                    ))}
                    </nav>

                    <!-- No card: the reader is open like the rest of the site, split from its text by hairlines -->
                    <article class="library-reader" id="library-reader" data-stack={libraries[0].stack}>
                        <header class="reader-head">
                            <div class="reader-title">
                                <p class="reader-stack">{libraries[0].title}</p>
                                <h3 class="reader-name" id="readerName">{first.name}</h3>
                            </div>
                            <dl class="reader-specs">
                                <div><dt>License</dt><dd class="reader-spdx">{first.spdx}</dd></div>
                                <div><dt>Website</dt><dd>
                                    <a class="reader-link" href={first.href} target="_blank" rel="noopener">
                                        <span class="reader-site">{siteLabel(first.href)}</span>
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                            stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                            <path d="M7 17 17 7"></path>
                                            <path d="M7 7h10v10"></path>
                                        </svg>
                                    </a>
                                </dd></div>
                            </dl>
                        </header>
                        <!-- Focusable so the keyboard can scroll the license -->
                        <pre class="reader-text" tabindex="0" role="region" aria-label="License text">Loading...</pre>
                    </article>
                </div>
            </div>
        </section>
    </main>

    <!-- Phones: the reader moves into this bottom sheet (scripts/credits.js) and slides up when a project is picked.
         Same overlay and surface as the license pop-up; drag the handle down, tap outside or press Escape to close. -->
    <dialog class="license-sheet" id="licenseSheet" aria-labelledby="readerName" slot="after-footer">
        <div class="sheet-panel">
            <div class="sheet-grab" aria-hidden="true"></div>
            <!-- autofocus: opening puts focus on Close, not on the website link further down -->
            <button class="modal-close sheet-close" type="button" aria-label="Close license" autofocus>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
                    stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
            </button>
            <div class="sheet-body" id="licenseSheetBody"></div>
        </div>
    </dialog>

    <script>
        import '../scripts/credits.js';
    </script>
</Base>
