---
import Base from '../layouts/Base.astro';
import '../styles/pages/home.css';
import Lightbox from '../components/Lightbox.astro';
import DownloadModal from '../components/DownloadModal.astro';
import DownloadButton from '../components/DownloadButton.astro';
import ZoomBadge from '../components/ZoomBadge.astro';
import { VERSION } from '../version';

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "https://track-n-race.com/#website",
      "url": "https://track-n-race.com/",
      "name": "Track N Race",
      "alternateName": [
        "Track-N-Race",
        "TrackNRace",
        "Track N Race F1 Telemetry"
      ],
      "description": "Free, open-source telemetry recording and lap performance analysis tool for F1 24, F1 25, and 2026 DLC.",
      "inLanguage": "en-US",
      "publisher": { "@id": "https://track-n-race.com/#author" }
    },
    {
      "@type": "Person",
      "@id": "https://track-n-race.com/#author",
      "name": "NoGoat",
      "url": "https://github.com/NoGoat",
      "sameAs": ["https://nogoat.in"]
    },
    {
      "@type": "SoftwareApplication",
      "@id": "https://track-n-race.com/#software",
      "name": "Track N Race",
      "alternateName": ["Track-N-Race", "Track N Race F1 Game telemetry"],
      "applicationCategory": "UtilitiesApplication",
      "softwareVersion": VERSION,
      "operatingSystem": "Windows, macOS, Linux",
      "url": "https://track-n-race.com/",
      "downloadUrl": "https://github.com/NoGoat/Track-N-Race/releases/latest",
      "sameAs": ["https://github.com/NoGoat/Track-N-Race"],
      "image": "https://track-n-race.com/assets/icons/icon_transparent_512.png",
      "license": "https://www.gnu.org/licenses/gpl-3.0.html",
      "description": "Comprehensive F1 Game telemetry recording and lap performance analysis software. Analyze throttle, brake, steering inputs, tyre degradation, power/ERS, and track delta times for F1 24, F1 25, and 2026 DLC.",
      "screenshot": "https://track-n-race.com/assets/screenshots/overview.webp",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "featureList": [
        "F1 24, F1 25, and 2026 DLC UDP Telemetry Support",
        "Real-time lap telemetry overlay and delta comparison",
        "Tyre wear, carcass temperature, and surface degradation analytics",
        "Driver inputs: Throttle, Brake, Steering, and Gear tracing",
        "Engine Power, Fuel usage, and ERS battery deployment monitoring",
        "Interactive circuit track maps with live driver positioning",
        "Lightweight background minimal recorder mode",
        "Customizable dashboard layout editor"
      ],
      "author": { "@id": "https://track-n-race.com/#author" }
    }
  ]
};
---
<Base jsonLd={jsonLd}>
    <Fragment slot="head">
        <!-- Primary Meta Tags -->
        <title>Track N Race — Free F1 Telemetry & Lap Analysis</title>
        <meta name="description"
            content="Track N Race records and analyzes F1 24, F1 25, and 2026 DLC telemetry. Compare laps, driver inputs, tyre wear, ERS, fuel, and delta times for free.">
        <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
        <meta name="google-site-verification" content="a99yyZ8By73b5OfZIi8xfglDVZORy-lbVjhQqVKTKwg" />
        <meta name="author" content="NoGoat">
        <meta name="application-name" content="Track N Race">
        <meta name="apple-mobile-web-app-title" content="Track N Race">
        <meta name="theme-color" content="#09090b">

        <!-- Open Graph / Facebook -->
        <meta property="og:type" content="website">
        <meta property="og:site_name" content="Track N Race">
        <meta property="og:locale" content="en_US">
        <meta property="og:url" content="https://track-n-race.com/">
        <meta property="og:title" content="Track N Race — Free F1 Telemetry & Lap Analysis">
        <meta property="og:description"
            content="Record and analyze F1 24, F1 25, and 2026 DLC telemetry. Compare laps, driver inputs, tyre wear, ERS, fuel, and delta times for free.">
        <meta property="og:image" content="https://track-n-race.com/assets/og-image.png">
        <meta property="og:image:width" content="1200">
        <meta property="og:image:height" content="630">
        <meta property="og:image:alt" content="Track N Race overview dashboard showing live speed, RPM and ERS traces with tyre temperatures">

        <!-- Twitter -->
        <meta name="twitter:card" content="summary_large_image">
        <meta name="twitter:url" content="https://track-n-race.com/">
        <meta name="twitter:title" content="Track N Race — Free F1 Telemetry & Lap Analysis">
        <meta name="twitter:description"
            content="Record and analyze F1 24, F1 25, and 2026 DLC telemetry. Compare laps, driver inputs, tyre wear, ERS, fuel, and delta times for free.">
        <meta name="twitter:image" content="https://track-n-race.com/assets/og-image.png">
        <meta name="twitter:image:alt" content="Track N Race overview dashboard showing live speed, RPM and ERS traces with tyre temperatures">

        <!-- Canonical URL -->
        <link rel="canonical" href="https://track-n-race.com/">

        <!-- Yandex verification -->
         <meta name="yandex-verification" content="a7e43f123b8e3335" />

        <!-- JSON-LD Structured Data -->
    </Fragment>

    <main>
        <!-- Hero Section -->
        <section id="hero" class="section hero-section">
            <div class="hero-content">
                <div class="hero-copy">
                    <h1 class="main-title">
                        Extract every<br>
                        <span class="gradient-text">last tenth.</span>
                    </h1>
                    <p class="subtitle">
                        Track N Race is a telemetry recording and analysis tool designed for the F1 games.
                        Analyze and find out where you lose that extra tenth over your competitors.
                    </p>
                    <div class="cta-group">
                        <!-- Opens the shared download modal; without it, the link still goes to the release -->
                        <DownloadButton />
                        <a class="secondary-btn" href="/setup/" data-astro-prefetch>
                            <span>Setup guide</span>
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M5 12h14"></path>
                                <path d="m12 5 7 7-7 7"></path>
                            </svg>
                        </a>
                    </div>
                </div>

                <dl class="hero-specs">
                    <div class="hero-spec">
                        <dt>Games</dt>
                        <dd><span class="tag">F1 24</span><span class="tag">F1 25</span><span class="tag">2026 DLC</span></dd>
                    </div>
                    <div class="hero-spec">
                        <dt>Platforms</dt>
                        <dd><span class="tag">Windows</span><span class="tag">macOS</span><span class="tag">Linux</span></dd>
                    </div>
                    <div class="hero-spec">
                        <dt>Qt version</dt>
                        <dd><span class="tag">Windows</span><span class="tag">Linux</span></dd>
                    </div>
                    <div class="hero-spec">
                        <dt>License</dt>
                        <dd><span class="tag">GPL-3.0</span><span class="tag">Open source</span></dd>
                    </div>
                </dl>
            </div>

            <div class="hero-visual">
                    <div class="app-window">
                        <div class="hero-img">
                            <picture>
                                <source type="image/avif" srcset="/assets/screenshots/overview-2492.avif">
                                <img src="/assets/screenshots/overview.webp"
                                    alt="Track N Race overview screen with speed, RPM and ERS traces from a lap of São Paulo, plus live tyre temperatures and damage readouts"
                                    class="mockup-img" width="2492" height="1492" fetchpriority="high">
                            </picture>
                            <ZoomBadge />
                        </div>
                    </div>
            </div>
        </section>

        <!-- Features Showcase Section -->
        <section id="features" class="section feature-section">
            <div class="section-header">
                <h2 class="section-heading">Highlights</h2>
                <a class="eyebrow section-link" href="/gallery/" data-astro-prefetch>
                    <span>See every screen</span>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                        stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M5 12h14"></path>
                        <path d="m12 5 7 7-7 7"></path>
                    </svg>
                </a>
            </div>

            <!-- Feature Carousel -->
            <div class="carousel-container">
                <div class="carousel-card">
                    <div class="carousel-viewport">
                        <div class="carousel-track">
                            <!-- Slide 1: Session files (TNRD) -->
                            <div class="carousel-slide active">
                                <div class="feature-container">
                                    <div class="feature-text">
                                        <h3 class="feature-title">Session <span class="highlight-red">Files</span>
                                        </h3>
                                        <p class="section-desc">
                                            Every session is saved as one .tnrd file, split by driver, by lap and by data type. Charts read only the blocks they need instead of the whole recording.
                                        </p>
                                        <ul class="feature-list">
                                            <li>One file per session, every driver and every lap</li>
                                            <li>Each driver, lap and data type is its own compressed block</li>
                                            <li>Charts load only the blocks they need</li>
                                            <li>Share it and compare laps against a friend's file in Analyze</li>
                                        </ul>
                                        <a class="eyebrow section-link feature-cta" href="/tnrd/" data-astro-prefetch>
                                            <span>View the history of .tnrd files</span>
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                                stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                <path d="M5 12h14"></path>
                                                <path d="m12 5 7 7-7 7"></path>
                                            </svg>
                                        </a>
                                    </div>
                                    <div class="feature-visual">
                                        <div class="tnrd-frame" data-src="/assets/tnrd-anim.svg" data-fallback="/assets/tnrd-static.svg">
                                            <noscript><img class="tnrd-static" src="/assets/tnrd-static.svg" alt="Alonso's slice of a .tnrd file as a table of laps and data types, with lap 5's speed, RPM and ERS blocks drawn as traces alongside" width="1600" height="1000"></noscript>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Slide 2: Analyze -->
                            <div class="carousel-slide">
                                <div class="feature-container">
                                    <div class="feature-text">
                                        <h3 class="feature-title">Deep <span class="highlight-blue">Analysis</span>
                                        </h3>
                                        <p class="section-desc">
                                            Dive deep into your race data. Compare any data of your choosing either your own laps or against rivals or laps from an older session to find out what's costing you time.
                                        </p>
                                        <ul class="feature-list">
                                            <li>Trace charts for almost any data</li>
                                            <li>Compare against other drivers</li>
                                            <li>Lap overlay comparisons</li>
                                            <li>Customizable colors and chart hierarchy</li>
                                            <li>Visualize your position on the map</li>
                                        </ul>
                                    </div>
                                    <div class="feature-visual">
                                        <div class="app-window">
                                            <div class="img-zoom-wrapper">
                                                <picture>
                                                    <source type="image/avif" srcset="/assets/screenshots/analyze-1280.avif 1280w, /assets/screenshots/analyze-1920.avif 1920w, /assets/screenshots/analyze-2624.avif 2624w"
                                                        sizes="(max-width: 860px) 100vw, (max-width: 1200px) 58vw, 700px">
                                                    <img src="/assets/screenshots/analyze.webp"
                                                        alt="Analysis view overlaying throttle, speed, RPM, gear and MGU-K power traces for two laps"
                                                        class="mockup-img" width="2624" height="1624" loading="lazy">
                                                </picture>
                                                <ZoomBadge />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Slide 3: Driver Selector -->
                            <div class="carousel-slide">
                                <div class="feature-container">
                                    <div class="feature-text">
                                        <h3 class="feature-title">Driver <span class="highlight-yellow">Selector</span>
                                        </h3>
                                        <p class="section-desc">
                                            View every other driver's data and compare almost* every data channel to your own.
                                        </p>
                                        <ul class="feature-list">
                                            <li>Select any driver in the session</li>
                                            <li>Compare their data^ against your own</li>
                                        </ul>
                                        <p class="post-script">*The game does not expose ride height data for other drivers. Ride height will be unavailable for other drivers.</p>
                                        <p class="post-script">^Some data channels will be unavailable if the other driver has set their telemetry to restricted during online play.</p>
                                    </div>
                                    <div class="feature-visual">
                                        <div class="app-window">
                                            <div class="img-zoom-wrapper">
                                                <picture>
                                                    <source type="image/avif" srcset="/assets/screenshots/driver_switcher-944.avif 944w"
                                                        sizes="(max-width: 860px) 100vw, (max-width: 1200px) 58vw, 700px">
                                                    <img src="/assets/screenshots/driver_switcher.webp"
                                                        alt="Driver switcher dropdown in the top bar listing the drivers in the session with their teams, Antonelli selected"
                                                        class="mockup-img fit-contain" width="944" height="830" loading="lazy">
                                                </picture>
                                                <ZoomBadge />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Slide 4: Session -->
                            <div class="carousel-slide">
                                <div class="feature-container">
                                    <div class="feature-text">
                                        <h3 class="feature-title">Track almost <span
                                                class="highlight-green">Everything</span></h3>
                                        <p class="section-desc">
                                            Track N Race tries to track as much information as possible from the apps.
                                            Everything from tyres to ride heights can be tracked.
                                        </p>
                                        <ul class="feature-list">
                                            <li>Record everything for future analysis</li>
                                            <li>Replay recordings like a video</li>
                                            <li>Includes track maps for almost* every circuit</li>
                                        </ul>
                                        <p class="post-script">*I do not own F1 24. So I couldn't get maps for
                                            any tracks exclusive to F1 24.</p>
                                    </div>
                                    <div class="feature-visual">
                                        <div class="app-window">
                                            <div class="img-zoom-wrapper">
                                                <picture>
                                                    <source type="image/avif" srcset="/assets/screenshots/session-1280.avif 1280w, /assets/screenshots/session-1920.avif 1920w, /assets/screenshots/session-2624.avif 2624w"
                                                        sizes="(max-width: 860px) 100vw, (max-width: 1200px) 58vw, 700px">
                                                    <img src="/assets/screenshots/session.webp"
                                                        alt="Session view with a live map of São Paulo showing every car's position, race details and an events feed"
                                                        class="mockup-img" width="2624" height="1624" loading="lazy">
                                                </picture>
                                                <ZoomBadge />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Slide 5: Minimal -->
                            <div class="carousel-slide">
                                <div class="feature-container">
                                    <div class="feature-text">
                                        <h3 class="feature-title">Minimal <span class="highlight-purple">Recorder</span>
                                        </h3>
                                        <p class="section-desc">
                                            Worried about performance penalties from running the app while playing the
                                            game?
                                            You can instead run the minimal recording and view your stats later in the
                                            main app.
                                        </p>
                                        <ul class="feature-list">
                                            <li>Full data logging</li>
                                            <li>Supports UDP forwarding</li>
                                            <li>Minimal performance overhead</li>
                                        </ul>
                                    </div>
                                    <div class="feature-visual">
                                        <div class="app-window">
                                            <div class="img-zoom-wrapper">
                                                <picture>
                                                    <source type="image/avif" srcset="/assets/screenshots/minimal_recorder-1464.avif 1464w"
                                                        sizes="(max-width: 860px) 100vw, (max-width: 1200px) 58vw, 700px">
                                                    <img src="/assets/screenshots/minimal_recorder.webp"
                                                        alt="Track N Race Minimal Recorder window showing the recording folder, UDP port and recording status"
                                                        class="mockup-img" width="1464" height="932" loading="lazy">
                                                </picture>
                                                <ZoomBadge />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="carousel-controls">
                    <button class="carousel-btn prev" aria-label="Previous slide">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="m15 18-6-6 6-6" />
                        </svg>
                    </button>
                    <div class="carousel-indicators">
                        <span class="dot active" data-slide="0"></span>
                        <span class="dot" data-slide="1"></span>
                        <span class="dot" data-slide="2"></span>
                        <span class="dot" data-slide="3"></span>
                        <span class="dot" data-slide="4"></span>
                    </div>
                    <button class="carousel-btn next" aria-label="Next slide">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="m9 18 6-6-6-6" />
                        </svg>
                    </button>
                </div>
            </div>

        </section>

        <!-- Alternate frontend: a carousel of Qt screens, linking to the Compare Frontends page -->
        <section id="alternate-frontend" class="section alt-frontend-section">
            <div class="section-header">
                <h2 class="section-heading">Qt frontend</h2>
                <a class="eyebrow section-link" href="/electron-vs-qt/" data-astro-prefetch>
                    <span>Compare Frontends</span>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                        stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M5 12h14"></path>
                        <path d="m12 5 7 7-7 7"></path>
                    </svg>
                </a>
            </div>
            <p class="section-desc alt-frontend-desc">
                Track N Race is also available with a native, Qt frontend. It uses less RAM, but I might forget to add a feature or two to Qt. <a href="/electron-vs-qt/" data-astro-prefetch>Compare the frontends to decide which frontend suits you the best.</a>
            </p>

            <div class="carousel-container alt-frontend-carousel">
                <div class="carousel-viewport">
                    <div class="carousel-track">
                        <div class="carousel-slide active">
                            <div class="shot shot-trimmed app-window">
                                <div class="img-zoom-wrapper">
                                    <picture>
                                        <source type="image/avif" srcset="/assets/screenshots/qt/overview-2492.avif"
                                            sizes="(max-width: 768px) 100vw, 1200px">
                                        <img src="/assets/screenshots/qt/overview.webp" alt="Qt frontend: Overview"
                                            class="mockup-img" width="2492" height="1492" loading="lazy">
                                    </picture>
                                    <ZoomBadge />
                                </div>
                            </div>
                        </div>
                        <div class="carousel-slide">
                            <div class="shot app-window">
                                <div class="img-zoom-wrapper">
                                    <picture>
                                        <source type="image/avif" srcset="/assets/screenshots/qt/analyze-1280.avif 1280w, /assets/screenshots/qt/analyze-1920.avif 1920w, /assets/screenshots/qt/analyze-2624.avif 2624w"
                                            sizes="(max-width: 768px) 100vw, 1200px">
                                        <img src="/assets/screenshots/qt/analyze.webp" alt="Qt frontend: Analysis"
                                            class="mockup-img" width="2624" height="1624" loading="lazy">
                                    </picture>
                                    <ZoomBadge />
                                </div>
                            </div>
                        </div>
                        <div class="carousel-slide">
                            <div class="shot app-window">
                                <div class="img-zoom-wrapper">
                                    <picture>
                                        <source type="image/avif" srcset="/assets/screenshots/qt/session-1280.avif 1280w, /assets/screenshots/qt/session-1920.avif 1920w, /assets/screenshots/qt/session-2624.avif 2624w"
                                            sizes="(max-width: 768px) 100vw, 1200px">
                                        <img src="/assets/screenshots/qt/session.webp" alt="Qt frontend: Session"
                                            class="mockup-img" width="2624" height="1624" loading="lazy">
                                    </picture>
                                    <ZoomBadge />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="carousel-controls">
                    <button class="carousel-btn prev" aria-label="Previous screenshot">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="m15 18-6-6 6-6" />
                        </svg>
                    </button>
                    <div class="carousel-indicators">
                        <span class="dot active" data-slide="0"></span>
                        <span class="dot" data-slide="1"></span>
                        <span class="dot" data-slide="2"></span>
                    </div>
                    <button class="carousel-btn next" aria-label="Next screenshot">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="m9 18 6-6-6-6" />
                        </svg>
                    </button>
                </div>
            </div>
        </section>
    </main>

    <DownloadModal slot="after-footer" />
    <Lightbox slot="after-footer" />

    <script>
        import '../scripts/carousel.js';
    </script>
</Base>
