---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { pages } from '../data/pages';
import '../styles/pages/home.css';
import Lightbox from '../components/Lightbox.astro';
import ZoomBadge from '../components/ZoomBadge.astro';
import { VERSION } from '../version';
import { asset } from '../asset-url';

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "https://track-n-race.com/#website",
      "url": "https://track-n-race.com/",
      "name": "Track N Race",
      "alternateName": [
        "Track-N-Race",
        "TrackNRace",
        "Track N Race F1 Telemetry"
      ],
      "description": "Free, open-source telemetry recording and lap performance analysis tool for F1 24, F1 25, and 2026 Season Pack, on Windows, macOS, Linux and Android.",
      "inLanguage": "en-US",
      "publisher": { "@id": "https://track-n-race.com/#author" }
    },
    {
      "@type": "Person",
      "@id": "https://track-n-race.com/#author",
      "name": "NoGoat",
      "url": "https://github.com/NoGoat",
      "sameAs": ["https://nogoat.in"]
    },
    {
      "@type": "SoftwareApplication",
      "@id": "https://track-n-race.com/#software",
      "name": "Track N Race",
      "alternateName": ["Track-N-Race", "Track N Race F1 Game telemetry"],
      "applicationCategory": "UtilitiesApplication",
      "softwareVersion": VERSION,
      "operatingSystem": "Windows, macOS, Linux, Android",
      "url": "https://track-n-race.com/",
      "downloadUrl": "https://github.com/NoGoat/Track-N-Race/releases/latest",
      "sameAs": ["https://github.com/NoGoat/Track-N-Race"],
      "image": "https://track-n-race.com/assets/icons/icon_transparent_512.png",
      "license": "https://www.gnu.org/licenses/gpl-3.0.html",
      "description": "Comprehensive F1 Game telemetry recording and lap performance analysis software. Analyze throttle, brake, steering inputs, tyre degradation, power/ERS, and track delta times for F1 24, F1 25, and 2026 Season Pack, on Windows, macOS, Linux and Android.",
      "screenshot": `https://track-n-race.com${asset('screenshots/overview.webp')}`,
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "featureList": [
        "F1 24, F1 25, and 2026 Season Pack UDP Telemetry Support",
        "Real-time lap telemetry overlay and delta comparison",
        "Tyre wear, carcass temperature, and surface degradation analytics",
        "Driver inputs: Throttle, Brake, Steering, and Gear tracing",
        "Engine Power, Fuel usage, and ERS battery deployment monitoring",
        "Interactive circuit track maps with live driver positioning",
        "Lightweight background minimal recorder mode",
        "Customizable dashboard layout editor",
        "Android app for phones and tablets, on its own or paired with the desktop app"
      ],
      "author": { "@id": "https://track-n-race.com/#author" }
    }
  ]
};
---
<Base jsonLd={jsonLd}>
    <Fragment slot="head">
        <PageHead page={pages.home} />
        <!-- Search engine verification -->
        <meta name="google-site-verification" content="a99yyZ8By73b5OfZIi8xfglDVZORy-lbVjhQqVKTKwg" />
        <meta name="yandex-verification" content="a7e43f123b8e3335" />
    </Fragment>

    <main id="main">
        <!-- Hero Section -->
        <section id="hero" class="section hero-section">
            <div class="hero-main">
                <div class="hero-copy">
                    <h1 class="main-title">
                        Extract every<br>
                        <span class="gradient-text">last tenth.</span>
                    </h1>
                    <p class="subtitle">
                        Track N Race is a telemetry recording and analysis tool designed for the F1 games.
                        Analyze and find out where you lose that extra tenth over your competitors.
                    </p>
                    <!-- The three things to know before downloading -->
                    <ul class="hero-points">
                        <li class="hero-point point-free">
                            <span class="hero-point-icon">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M12.586 2.586A2 2 0 0 0 11.172 2H4a2 2 0 0 0-2 2v7.172a2 2 0 0 0 .586 1.414l8.704 8.704a2.426 2.426 0 0 0 3.42 0l6.58-6.58a2.426 2.426 0 0 0 0-3.42z"></path>
                                    <circle cx="7.5" cy="7.5" r=".5" fill="currentColor"></circle>
                                </svg>
                            </span>
                            <span><strong>Free</strong> and open source</span>
                        </li>
                        <li class="hero-point point-files">
                            <span class="hero-point-icon">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"></path>
                                    <path d="M14 2v4a2 2 0 0 0 2 2h4"></path>
                                </svg>
                            </span>
                            <span><strong>Save and share</strong> sessions with your racing buddies</span>
                        </li>
                        <li class="hero-point point-analysis">
                            <span class="hero-point-icon">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M3 3v16a2 2 0 0 0 2 2h16"></path>
                                    <path d="m19 9-5 5-4-4-3 3"></path>
                                </svg>
                            </span>
                            <span><strong>Analysis workspace</strong> for laps, drivers and sessions</span>
                        </li>
                    </ul>
                    <!-- One wide Download button; the rest are quiet links under it -->
                    <div class="hero-cta">
                        <!-- Goes to the Download page, which walks through the builds for each platform -->
                        <a class="primary-btn hero-download" href="/download/" data-astro-prefetch>
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                                <polyline points="7 10 12 15 17 10"></polyline>
                                <line x1="12" y1="15" x2="12" y2="3"></line>
                            </svg>
                            <span>Download Track N Race</span>
                            <span class="hero-download-ver">{VERSION}</span>
                        </a>
                    </div>
                    <nav class="hero-links" aria-label="Get started">
                        <a href="/setup/" data-astro-prefetch>
                            <span>Setup guide</span>
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M5 12h14"></path>
                                <path d="m12 5 7 7-7 7"></path>
                            </svg>
                        </a>
                        <a href="/analysis/" data-astro-prefetch>
                            <span>Analysis Tour</span>
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M5 12h14"></path>
                                <path d="m12 5 7 7-7 7"></path>
                            </svg>
                        </a>
                        <a href="https://discord.gg/UMVRrN3RbR" target="_blank" rel="noopener">
                            <span>Discord</span>
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M7 17 17 7"></path>
                                <path d="M7 7h10v10"></path>
                            </svg>
                        </a>
                    </nav>
                </div>

                <div class="hero-visual">
                    <div class="app-window">
                        <div class="hero-img">
                            <picture>
                                <source type="image/avif"
                                    srcset={`${asset('screenshots/overview-1280.avif')} 1280w, ${asset('screenshots/overview-1920.avif')} 1920w, ${asset('screenshots/overview-2492.avif')} 2492w`}
                                    sizes="(min-width: 1248px) 760px, (min-width: 960px) 62vw, 100vw">
                                <img src={asset('screenshots/overview.webp')} data-full={asset('screenshots/overview.png')}
                                    alt="Track N Race overview screen with speed, RPM and ERS traces from a lap of São Paulo, plus live tyre temperatures and damage readouts"
                                    class="mockup-img" width="2492" height="1492" fetchpriority="high">
                            </picture>
                            <ZoomBadge />
                        </div>
                    </div>
                </div>
            </div>

            <dl class="hero-specs">
                <div class="hero-spec">
                    <dt>Games</dt>
                    <dd><span class="tag">F1 24</span><span class="tag">F1 25</span><span class="tag">2026 Season Pack</span></dd>
                </div>
                <div class="hero-spec">
                    <dt>Platforms</dt>
                    <dd><span class="tag">Windows</span><span class="tag">macOS</span><span class="tag">Linux</span><span class="tag">Android</span></dd>
                </div>
                <div class="hero-spec">
                    <dt>License</dt>
                    <dd><span class="tag">GPL-3.0</span><span class="tag">Open source</span></dd>
                </div>
            </dl>
        </section>

        <!-- Features Showcase Section -->
        <section id="features" class="section feature-section">
            <div class="section-header">
                <h2 class="section-heading">Highlights</h2>
                <a class="eyebrow section-link" href="/gallery/" data-astro-prefetch>
                    <span>See every screen</span>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                        stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M5 12h14"></path>
                        <path d="m12 5 7 7-7 7"></path>
                    </svg>
                </a>
            </div>

            <!-- Session Files leads at full width; Deep Analysis and the other two highlights share the row under it -->
            <article class="feature-lead">
                <div class="feature-text">
                    <h3 class="feature-title">Session <span class="highlight-red">Files</span></h3>
                    <p class="section-desc">
                        Every session is saved as one .tnrd file, split by driver, by lap and by data type. Charts read only the blocks they need instead of the whole recording.
                    </p>
                    <ul class="feature-list">
                        <li>Store all telemetry for later in depth analysis</li>
                        <li>Files work across Free Practice, Quali, and Races.</li>
                        <li>Compare laps with other Track N Race users</li>
                        <li>Export to Parquet for use with other applications</li>
                    </ul>
                    <dl class="feature-stats">
                        <div><dt>76 MB</dt><dd>from 2.5 GB of raw telemetry*</dd></div>
                        <div><dt>~0.1 s</dt><dd>to read 72 laps of speed, RPM, ERS and tyres from the file^</dd></div>
                    </dl>
                    <p class="post-script">*92 minute São Paulo Grand Prix, 22 cars. ^Same file, already in the OS cache. Reading the file only: drawing the charts in the app takes extra time. Results vary with the race and your hardware.</p>
                    <a class="eyebrow section-link feature-link" href="/tnrd/" data-astro-prefetch>
                        <span>Learn more about TNRD files</span>
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                            stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M5 12h14"></path>
                            <path d="m12 5 7 7-7 7"></path>
                        </svg>
                    </a>
                </div>
                <div class="feature-visual">
                    <div class="tnrd-frame" data-src={asset('tnrd-anim.svg')} data-fallback={asset('tnrd-static.svg')}>
                        <noscript><img class="tnrd-static" src={asset('tnrd-static.svg')} alt="Alonso's slice of a .tnrd file as a table of laps and data types, with lap 5's speed, RPM and ERS blocks drawn as traces alongside" width="1600" height="1000"></noscript>
                    </div>
                </div>
            </article>

            <div class="feature-trio">
                <!-- TODO: Update the Deep Analysis copy for the new Analysis screen. The feature list doesn't mention braking zones or map layers yet -->
                <!-- Deep Analysis, linking to the Analysis page -->
                <article class="feature-card">
                    <div class="feature-visual">
                        <div class="app-window">
                            <div class="img-zoom-wrapper">
                                <picture>
                                    <source type="image/avif" srcset={`${asset('screenshots/analyze-1280.avif')} 1280w, ${asset('screenshots/analyze-1920.avif')} 1920w, ${asset('screenshots/analyze-2624.avif')} 2624w`}
                                        sizes="(max-width: 860px) 100vw, (max-width: 1200px) 33vw, 420px">
                                    <img src={asset('screenshots/analyze.webp')} data-full={asset('screenshots/analyze.png')}
                                        alt="Analysis split view comparing Antonelli's lap 7 with Leclerc's lap 9: delta, throttle, speed, ERS and brake traces beside the track map, and a braking zones panel with the gap in each zone"
                                        class="mockup-img" width="2624" height="1624" loading="lazy">
                                </picture>
                                <ZoomBadge />
                            </div>
                        </div>
                    </div>
                    <div class="feature-text">
                        <h3 class="feature-title">Deep <span class="highlight-blue">Analysis</span></h3>
                        <p class="section-desc">
                            Dive deep into your race data. Compare any data of your choosing either your own laps or against rivals or laps from an older session to find out what's costing you time.
                        </p>
                        <ul class="feature-list is-compact">
                            <li>Compare laps between two sessions. Could be your own sessions or your mate's sessions.</li>
                            <li>Trace charts for almost any data</li>
                            <li>Compare against other drivers</li>
                            <li>Lap overlay comparisons</li>
                            <li>Customizable colors and chart hierarchy</li>
                            <li>Visualize your position on the map</li>
                        </ul>
                        <a class="eyebrow section-link feature-link" href="/analysis/" data-astro-prefetch>
                            <span>See the Analysis Workspace in Action</span>
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M5 12h14"></path>
                                <path d="m12 5 7 7-7 7"></path>
                            </svg>
                        </a>
                    </div>
                </article>

                <!-- Driver Selector -->
                <article class="feature-card">
                    <div class="feature-visual">
                        <div class="app-window">
                            <div class="img-zoom-wrapper">
                                <picture>
                                    <source type="image/avif" srcset={`${asset('screenshots/driver_switcher-944.avif')} 944w`}
                                        sizes="(max-width: 860px) 100vw, (max-width: 1200px) 33vw, 420px">
                                    <img src={asset('screenshots/driver_switcher.webp')} data-full={asset('screenshots/driver_switcher.png')}
                                        alt="Driver switcher dropdown in the top bar listing the drivers in the session with their teams, Antonelli selected"
                                        class="mockup-img fit-contain" width="944" height="830" loading="lazy">
                                </picture>
                                <ZoomBadge />
                            </div>
                        </div>
                    </div>
                    <div class="feature-text">
                        <h3 class="feature-title">Driver <span class="highlight-yellow">Selector</span></h3>
                        <p class="section-desc">
                            View every other driver's data and compare almost* every data channel to your own.
                        </p>
                        <ul class="feature-list is-compact">
                            <li>Select any driver in the session</li>
                            <li>Compare their data^ against your own</li>
                        </ul>
                        <p class="post-script">*The game does not expose ride height data for other drivers. Ride height will be unavailable for other drivers.</p>
                        <p class="post-script">^Some data channels will be unavailable if the other driver has set their telemetry to restricted during online play.</p>
                    </div>
                </article>

                <!-- Session -->
                <article class="feature-card">
                    <div class="feature-visual">
                        <div class="app-window">
                            <div class="img-zoom-wrapper">
                                <picture>
                                    <source type="image/avif" srcset={`${asset('screenshots/session-1280.avif')} 1280w, ${asset('screenshots/session-1920.avif')} 1920w, ${asset('screenshots/session-2624.avif')} 2624w`}
                                        sizes="(max-width: 860px) 100vw, (max-width: 1200px) 33vw, 420px">
                                    <img src={asset('screenshots/session.webp')} data-full={asset('screenshots/session.png')}
                                        alt="Session view with a live map of São Paulo showing every car's position, race details and an events feed"
                                        class="mockup-img" width="2624" height="1624" loading="lazy">
                                </picture>
                                <ZoomBadge />
                            </div>
                        </div>
                    </div>
                    <div class="feature-text">
                        <h3 class="feature-title">Track almost <span class="highlight-green">Everything</span></h3>
                        <p class="section-desc">
                            Track N Race tries to track as much information as possible from the apps.
                            Everything from tyres to ride heights can be tracked.
                        </p>
                        <ul class="feature-list is-compact">
                            <li>Record everything for future analysis</li>
                            <li>Replay recordings like a video</li>
                            <li>Includes track maps for almost* every circuit</li>
                        </ul>
                        <p class="post-script">*Maps will be built on the fly for missing tracks,
                            such as modded tracks. It will take a couple of laps to collect the data
                            and build the maps.</p>
                    </div>
                </article>
            </div>

        </section>

        <!-- Meet the frontends: one slide per build, each with what it is best at -->
        <section id="frontends" class="section alt-frontend-section">
            <div class="section-header">
                <h2 class="section-heading">Meet the frontends</h2>
                <a class="eyebrow section-link" href="/frontends/" data-astro-prefetch>
                    <span>Compare Frontends</span>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                        stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M5 12h14"></path>
                        <path d="m12 5 7 7-7 7"></path>
                    </svg>
                </a>
            </div>

            <!-- The four builds side by side: screenshot, then what each one is best at -->
            <div class="frontend-grid">
                <!-- Electron -->
                <article class="feature-card">
                    <div class="feature-visual">
                        <div class="app-window">
                            <div class="img-zoom-wrapper">
                                <picture>
                                    <source type="image/avif" srcset={`${asset('screenshots/overview-1280.avif')} 1280w, ${asset('screenshots/overview-1920.avif')} 1920w, ${asset('screenshots/overview-2492.avif')} 2492w`}
                                        sizes="(max-width: 600px) 100vw, (max-width: 1100px) 50vw, 310px">
                                    <img src={asset('screenshots/overview.webp')} data-full={asset('screenshots/overview.png')}
                                        alt="Electron frontend: Overview screen with speed, RPM and ERS traces, tyre temperatures and damage readouts"
                                        class="mockup-img" width="2492" height="1492" loading="lazy">
                                </picture>
                                <ZoomBadge />
                            </div>
                        </div>
                    </div>
                    <div class="feature-text">
                        <h3 class="feature-title">Electron <span class="highlight-periwinkle">Frontend</span></h3>
                        <p class="section-desc">
                            The full app on every desktop, and the only full one on macOS.
                        </p>
                        <ul class="feature-list is-compact">
                            <li>Windows, macOS and Linux</li>
                            <li>Live telemetry, lap analysis and the layout editor</li>
                            <li>Records sessions and plays them back</li>
                            <li>Forwards UDP to other apps</li>
                        </ul>
                        <a class="eyebrow section-link feature-cta" href="/frontends/" data-astro-prefetch>
                            <span>Compare the desktop builds</span>
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M5 12h14"></path>
                                <path d="m12 5 7 7-7 7"></path>
                            </svg>
                        </a>
                    </div>
                </article>

                <!-- Native -->
                <article class="feature-card">
                    <div class="feature-visual">
                        <div class="app-window">
                            <div class="img-zoom-wrapper">
                                <picture>
                                    <source type="image/avif" srcset={`${asset('screenshots/qt/session-1280.avif')} 1280w, ${asset('screenshots/qt/session-1920.avif')} 1920w, ${asset('screenshots/qt/session-2624.avif')} 2624w`}
                                        sizes="(max-width: 600px) 100vw, (max-width: 1100px) 50vw, 310px">
                                    <img src={asset('screenshots/qt/session.webp')} data-full={asset('screenshots/qt/session.png')}
                                        alt="Native frontend: Session screen with a live map of São Paulo, race details and an events feed"
                                        class="mockup-img" width="2624" height="1624" loading="lazy">
                                </picture>
                                <ZoomBadge />
                            </div>
                        </div>
                    </div>
                    <div class="feature-text">
                        <h3 class="feature-title">Native <span class="highlight-lilac">Frontend</span></h3>
                        <p class="section-desc">
                            Every screen Electron has, built with Qt, in a good deal less memory.
                        </p>
                        <ul class="feature-list is-compact">
                            <li>Windows and Linux</li>
                            <li>1:1 parity with Electron</li>
                            <li>444 MB at the end of a live race, against 714 MB</li>
                            <li>Records sessions and plays them back</li>
                        </ul>
                        <a class="eyebrow section-link feature-cta" href="/frontends/" data-astro-prefetch>
                            <span>Compare the desktop builds</span>
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M5 12h14"></path>
                                <path d="m12 5 7 7-7 7"></path>
                            </svg>
                        </a>
                    </div>
                </article>

                <!-- Minimal Recorder -->
                <article class="feature-card">
                    <div class="feature-visual">
                        <div class="app-window">
                            <div class="img-zoom-wrapper">
                                <picture>
                                    <source type="image/avif" srcset={`${asset('screenshots/minimal_recorder-1464.avif')} 1464w`}
                                        sizes="(max-width: 600px) 100vw, (max-width: 1100px) 50vw, 310px">
                                    <img src={asset('screenshots/minimal_recorder.webp')} data-full={asset('screenshots/minimal_recorder.png')}
                                        alt="Track N Race Minimal Recorder window showing the recording folder, UDP port and recording status"
                                        class="mockup-img" width="1464" height="932" loading="lazy">
                                </picture>
                                <ZoomBadge />
                            </div>
                        </div>
                    </div>
                    <div class="feature-text">
                        <h3 class="feature-title">Minimal <span class="highlight-coral">Recorder</span></h3>
                        <p class="section-desc">
                            Worried about performance penalties from running the app while playing the
                            game?
                            You can instead run the Minimal Recorder and view your stats later in the
                            main app.
                        </p>
                        <ul class="feature-list is-compact">
                            <li>Full data logging</li>
                            <li>Supports UDP forwarding</li>
                            <li>Minimal performance overhead</li>
                        </ul>
                    </div>
                </article>

                <!-- Android -->
                <article class="feature-card">
                    <div class="feature-visual">
                        <div class="shot-android app-window">
                            <div class="img-zoom-wrapper">
                                <picture>
                                    <source type="image/avif" srcset={`${asset('screenshots/android/overview-1280.avif')} 1280w, ${asset('screenshots/android/overview-1920.avif')} 1920w, ${asset('screenshots/android/overview-2560.avif')} 2560w`}
                                        sizes="(max-width: 600px) 100vw, (max-width: 1100px) 50vw, 310px">
                                    <img src={asset('screenshots/android/overview.webp')} data-full={asset('screenshots/android/overview.png')}
                                        alt="Android app on a tablet: Drive tab with lap time, delta, gear, speed, ERS, fuel, gaps and tyre wear"
                                        class="mockup-img" width="2560" height="1488" loading="lazy">
                                </picture>
                                <ZoomBadge />
                            </div>
                        </div>
                    </div>
                    <div class="feature-text">
                        <h3 class="feature-title">Android <span class="highlight-mint">App</span></h3>
                        <p class="section-desc">
