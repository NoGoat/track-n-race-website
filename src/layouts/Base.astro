---
// The page shell: head, header, footer and license pop-up, with the script every page needs. Each page imports its
// own stylesheet bundle (styles/pages/), which starts with base.css and site.css.
// A page passes its own <title> and meta tags in the "head" slot, and anything that sits after the footer
// (the download modal, the lightbox) in the "after-footer" slot.
// A page with a version built for no JavaScript (data/nojs.ts) passes it as nojs: a noscript refresh opens it. Pages
// that need JavaScript and have none pass the home page's version instead.
// <html> starts as .no-js, and the first script in the head swaps that for .js before anything is drawn, for the
// little every page needs either way: .nojs-only / .js-only (base.css) mark elements for just one of the two, like
// the header's menu button.
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LicenseModal from '../components/LicenseModal.astro';

interface Props {
    /** Structured data for search engines, written out as JSON-LD */
    jsonLd?: object;
    bodyClass?: string;
    /** Where browsers without JavaScript go: this page's version under /no-js/, or the home page's */
    nojs?: string;
}

const { jsonLd, bodyClass, nojs } = Astro.props;
---
<!DOCTYPE html>
<html lang="en" data-theme="dark" class="no-js">

<head>
    <meta charset="UTF-8">
    <script is:inline>document.documentElement.classList.replace('no-js', 'js');</script>
    {nojs && <noscript><meta http-equiv="refresh" content={`0; url=${nojs}`}></noscript>}
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <slot name="head" />

    {jsonLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd, null, 2)} />}

    <!-- Favicon & App Icons -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <link rel="icon" type="image/png" sizes="48x48" href="/assets/icons/favicon-48x48.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/icons/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/assets/icons/favicon-16x16.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/icons/apple-touch-icon.png">
    <link rel="manifest" href="/site.webmanifest">

    <!-- Fonts -->
    <link rel="preload" href="/assets/fonts/geist-latin.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/assets/fonts/geist-mono-latin.woff2" as="font" type="font/woff2" crossorigin>
</head>

<body class={bodyClass}>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />

    <slot />

    <Footer />

    <slot name="after-footer" />

    <LicenseModal />

    <script>
        import '../scripts/site.js';
    </script>
</body>

</html>
