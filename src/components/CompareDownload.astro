---
// The Frontends page's closing call to action, also on its version without JavaScript: a ruled row, heading and line
// on the left, the button to the Download page (or its no-JS version) on the right
import DownloadButton from './DownloadButton.astro';
---
<div class="compare-download">
    <div class="compare-download-text">
        <h2 class="section-heading">Picked one?</h2>
        <p class="section-desc">Every build is free and open source, for Windows, macOS and Linux.</p>
    </div>
    <DownloadButton page />
</div>
