---
// One frontend's capture of a screen (src/data/screens.ts): AVIF at each width, WebP as the fallback.
// data-ui marks the frontend, so the Gallery's switch can show one and hide the other.
import type { Screen } from '../data/screens';

interface Props {
    screen: Screen;
    ui: 'electron' | 'qt';
    sizes: string;
    lazy?: boolean;
}

const { screen, ui, sizes, lazy = false } = Astro.props;
const dir = ui === 'qt' ? '/assets/screenshots/qt' : '/assets/screenshots';
const widths = ui === 'qt' ? screen.qtWidths : screen.widths;
// A single size needs no width descriptors (or sizes) for the browser to pick from
const srcset = widths.length === 1
    ? `${dir}/${screen.file}-${widths[0]}.avif`
    : widths.map(w => `${dir}/${screen.file}-${w}.avif ${w}w`).join(', ');
---
<picture data-ui={ui}>
    <source type="image/avif" srcset={srcset} sizes={widths.length === 1 ? undefined : sizes}>
    <img src={`${dir}/${screen.file}.webp`} alt={screen.alt}
        class="mockup-img" width={screen.width} height={screen.height} loading={lazy ? 'lazy' : undefined}>
</picture>
