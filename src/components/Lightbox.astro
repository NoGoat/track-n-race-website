---
// Click-to-zoom for every .mockup-img on the page. Its styles (lightbox.css) are in the bundles of the pages
// that use it (styles/pages/).
---
<div class="lightbox" id="lightbox">
    <button class="lightbox-close" id="lightboxClose" aria-label="Close image">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
            stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
    </button>
    <div class="lightbox-scroll" id="lightboxScroll">
        <div class="lightbox-centerer" id="lightboxCenterer">
            <img alt="Enlarged view" loading="lazy">
        </div>
    </div>
</div>

<script>
    import '../scripts/lightbox.js';
</script>
