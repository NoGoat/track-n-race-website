---
// The license pop-up: the footer's GPL link opens it (scripts/site.js)
---
<dialog class="license-modal" id="licenseModal" aria-labelledby="licenseModalTitle">
    <div class="modal-content">
        <div class="modal-header">
            <h3 id="licenseModalTitle">License Details</h3>
            <button class="modal-close" id="closeLicenseModal" type="button" aria-label="Close license">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
                    stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
            </button>
        </div>
        <!-- Focusable so the keyboard can scroll the license -->
        <div class="modal-body" tabindex="0" role="region" aria-label="License text">
            <pre id="licenseTextContent">Loading...</pre>
        </div>
    </div>
</dialog>
