---
// The Expand Image button on a screenshot: it covers the frame and opens the screenshot in the lightbox
// (scripts/lightbox.js). Its badge shows on hover and on keyboard focus. Without JavaScript there's no lightbox, so
// it's left out.
---
<button class="zoom-btn js-only" type="button">
    <span class="zoom-badge">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="2" aria-hidden="true">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            <line x1="11" y1="8" x2="11" y2="14"></line>
            <line x1="8" y1="11" x2="14" y2="11"></line>
        </svg>
        <span>Expand Image</span>
    </span>
</button>
