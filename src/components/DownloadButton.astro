---
// Opens the download modal (DownloadModal.astro); without it, the link goes to the release.
// With page, it's a plain link to the Download page instead (the home page's hero), and needs no modal.
import { VERSION } from '../version';

interface Props {
    page?: boolean;
}
const { page = false } = Astro.props;
---
{page ? (
    <a class="primary-btn" href="/download/" data-astro-prefetch>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
        </svg>
        <span>Download {VERSION}</span>
    </a>
) : (
    <a class="primary-btn" href="/download/release"
        target="_blank" rel="noopener nofollow" data-download>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
        </svg>
        <span>Download {VERSION}</span>
    </a>
)}
