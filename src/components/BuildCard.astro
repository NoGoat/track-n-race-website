---
// One build's card in a Download page guide (pages/download.astro). Styles in styles/download.css and
// download-modal.css.
//
// For more than one OS (Windows and Linux share a guide), every per-OS value and link is rendered, marked data-os-only,
// and the page's CSS shows the chosen platform's; for one OS, the values are picked here.
// Each link is its /download/<slug> redirect (worker/index.js counts the hits and labels bots); data-build names the
// build for scripts/download-next.js.
import type { Build, PerOs } from '../data/downloads';
import { osLabels } from '../data/downloads';

interface Props {
    build: Build;
    oses: string[];
}
const { build, oses } = Astro.props;
const single = oses.length === 1 ? oses[0] : null;
const pick = (value: PerOs) => typeof value === 'string' ? value : value[single!];

const downloadIcon = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>';
// Lucide-style: a check for the default pick, a feather for the lighter fallback, a warning for a catch
const badgeIcons = {
    pick: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>',
    alt: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.24 12.24a6 6 0 0 0-8.49-8.49L5 10.5V19h8.5z"/><line x1="16" y1="8" x2="2" y2="22"/><line x1="17.5" y1="15" x2="9" y2="15"/></svg>',
    warn: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>',
};
---
<article class="dl-build">
    {build.stack && (
        <p class="eyebrow dl-build-stack">
            {single || typeof build.stack === 'string' ? pick(build.stack) : Object.entries(build.stack).map(([os, v]) => (
                <span data-os-only={os}>{v}</span>
            ))}
        </p>
    )}
    <h3 class="download-build-name">{build.name}</h3>
    {build.badge && (
        <p class="dl-badge" data-tone={build.badge.tone}>
            <Fragment set:html={badgeIcons[build.badge.tone]} />
            <span>{build.badge.text}</span>
        </p>
    )}
    <p class="download-build-desc">{build.desc}</p>
    <ul class="dl-points">
        {build.pros.map(t => <li class="dl-pro"><span class="visually-hidden">Advantage: </span>{t}</li>)}
        {build.cons.map(t => <li class="dl-con"><span class="visually-hidden">Disadvantage: </span>{t}</li>)}
    </ul>
    <dl class="download-build-specs">
        {build.specs.map(([label, value]) => (
            <div><dt>{label}</dt><dd>
                {single || typeof value === 'string' ? pick(value) : Object.entries(value).map(([os, v]) => (
                    <span data-os-only={os}>{v}</span>
                ))}
            </dd></div>
        ))}
    </dl>
    {oses.map(os => (
        <a class="download-build-get" data-os-only={single ? undefined : os} data-build={`${build.slug}/${os}`}
            href={`/download/${build.slug}/${os}`} rel="nofollow">
            <Fragment set:html={downloadIcon} />
            <span>{build.cta ?? `Download ${build.name}`}<span class="visually-hidden"> for {osLabels[os]}</span></span>
        </a>
    ))}
</article>
