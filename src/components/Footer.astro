---
// The footer. The GPL link opens the license pop-up (scripts/site.js).
const pages = [
    { href: '/', label: 'Home' },
    { href: '/gallery/', label: 'Gallery' },
    { href: '/electron-vs-qt/', label: 'Compare Frontends' },
    { href: '/setup/', label: 'Setup' },
    { href: '/tnrd/', label: 'TNRD Files' },
    { href: '/credits/', label: 'Credits' },
    { href: '/privacy/', label: 'Privacy Policy' },
];
const current = Astro.url.pathname;
---
<footer class="site-footer">
    <div class="footer-container">
        <div class="footer-left">
            <span class="footer-brand"><span class="brand-accent">Track</span> N Race</span>
            <p class="footer-desc">
                Copyright &copy; 2026 NoGoat. Track N Race is distributed under the <button type="button"
                    class="footer-license" data-license="GPL-3.0.txt">GNU
                    General Public License v3.0</button>
            </p>
            <p class="footer-disclaimer">
                Track N Race is not affiliated with, endorsed by, or associated with EA, Codemasters, Formula One,
                the FIA, the drivers or the teams participating in Formula One.
            </p>
        </div>
        <ul class="footer-links">
            {pages.map(({ href, label }) => (
                <li><a href={href} data-astro-prefetch aria-current={href === current ? 'page' : undefined}>{label}</a></li>
            ))}
            <li><a href="https://github.com/NoGoat/Track-N-Race" target="_blank" rel="noopener">GitHub</a></li>
            <!-- Discord invite link: replace the href below (and in Header.astro) -->
            <li><a href="https://discord.gg/UMVRrN3RbR" target="_blank" rel="noopener">Discord</a></li>
        </ul>
    </div>
</footer>
