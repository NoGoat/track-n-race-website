---
// The footer. The GPL link opens the license pop-up (scripts/site.js); without JavaScript it opens the text file.
// On /no-js/ pages the links go to the other pages' versions without JavaScript, and pages that need it are left out
// (data/nojs.ts).
import { linkFor, isCurrent, showsOn } from '../data/nojs';

const pages = [
    { href: '/', label: 'Home' },
    { href: '/gallery/', label: 'Gallery' },
    { href: '/electron-vs-qt/', label: 'Compare Frontends' },
    { href: '/download/', label: 'Download' },
    { href: '/setup/', label: 'Setup' },
    { href: '/tnrd/', label: 'TNRD Files' },
    { href: '/credits/', label: 'Credits' },
    { href: '/privacy/', label: 'Privacy Policy' },
];
const path = Astro.url.pathname;
---
<footer class="site-footer">
    <div class="footer-container">
        <div class="footer-left">
            <span class="footer-brand"><span class="brand-accent">Track</span> N Race</span>
            <p class="footer-desc">
                Copyright &copy; 2026 NoGoat. Track N Race is distributed under the <a
                    class="footer-license" href="/assets/licenses/GPL-3.0.txt" data-license="GPL-3.0.txt">GNU
                    General Public License v3.0</a>
            </p>
            <p class="footer-disclaimer">
                Track N Race is not affiliated with, endorsed by, or associated with EA, Codemasters, Formula One,
                the FIA, the drivers or the teams participating in Formula One.
            </p>
        </div>
        <ul class="footer-links">
            {pages.filter(({ href }) => showsOn(href, path)).map(({ href, label }) => (
                <li><a href={linkFor(href, path)} data-astro-prefetch aria-current={isCurrent(href, path) ? 'page' : undefined}>{label}</a></li>
            ))}
            <li><a href="https://github.com/NoGoat/Track-N-Race" target="_blank" rel="noopener">GitHub</a></li>
            <!-- Discord invite link: replace the href below (and in Header.astro) -->
            <li><a href="https://discord.gg/UMVRrN3RbR" target="_blank" rel="noopener">Discord</a></li>
        </ul>
    </div>
</footer>
