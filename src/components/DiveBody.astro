---
// One platform's guide on the Download page: the intro, the build cards, the advice and where the RAM figures come
// from. oses are the platforms its cards carry links for (BuildCard).
import BuildCard from './BuildCard.astro';
import type { Dive } from '../data/downloads';

interface Props {
    dive: Dive;
    oses: string[];
}
const { dive, oses } = Astro.props;
---
<div class="dl-dive-body">
    <p class="dl-intro">{dive.intro}</p>
    <div class="dl-builds" data-count={dive.builds.length}>
        {dive.builds.map(build => <BuildCard build={build} oses={oses} />)}
    </div>
    {dive.advice && <p class="dl-advice">{dive.advice}</p>}
    {dive.ramNote && (
        <p class="dl-note">
            RAM measured on Windows 11 over a 92-minute race. How, and every figure, on the
            <a href="/electron-vs-qt/#at-a-glance" data-astro-prefetch>Frontends page</a>.
        </p>
    )}
</div>
