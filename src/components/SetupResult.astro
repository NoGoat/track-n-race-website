---
// The Setup page's result: the steps for the answers given. Every block is marked data-when / data-fill, and
// scripts/setup.js shows the ones that apply, numbers the steps and fills in the names as the answers change.
// Without JavaScript the page shows components/SetupAll.astro instead, so a change here may belong there too.
//
// The result is short: opening the app the first time, one Pre-race checklist for everything to set, and links into
// the Troubleshooting page for when it doesn't work.
import { icon } from '../data/setup';
import FirstLaunch from './FirstLaunch.astro';
import CheckItem from './CheckItem.astro';
import AddressMethods from './AddressMethods.astro';
import FirewallFix from './FirewallFix.astro';
import ForwardSteps from './ForwardSteps.astro';
import ForwardPorts from './ForwardPorts.astro';
---
<!-- Your setup: shown once every question that applies is answered -->
<section class="setup-result js-only" id="setupResult" data-when="complete=yes" aria-labelledby="resultTitle" tabindex="-1">
    <div class="result-head">
        <div>
            <p class="eyebrow">Your setup</p>
            <h2 class="result-title" id="resultTitle">
                <span data-when="link=desktop">Track N Race on a computer</span>
                <span data-when="link=direct">Android, Direct mode</span>
                <span data-when="link=paired">Desktop + Android, Paired mode</span>
            </h2>
        </div>
        <div class="result-actions">
            <button class="copy-action-btn" type="button" id="copySetupLink" data-copy="">
                <Fragment set:html={icon.copy} />
                <span class="copy-label">Copy link</span><span class="visually-hidden"> to this setup</span>
            </button>
            <button class="copy-action-btn" type="button" id="resetSetup">Start over</button>
        </div>
    </div>

    <!-- Where the data goes -->
    <ol class="flow-diagram" aria-label="How telemetry travels">
        <li class="flow-node">
            <span class="flow-icon" set:html={icon.gamepad} />
            <span class="flow-name"><span data-fill="game-name">F1</span></span>
            <span class="flow-detail">on <span data-fill="platform-name">your device</span></span>
        </li>
        <li class="flow-link">
            <span class="flow-link-label">UDP · 20777</span>
            <span class="flow-link-detail" data-when="ip=loopback">inside this PC</span>
            <span class="flow-link-detail" data-when="ip=windows,macos,linux,android">over your network</span>
        </li>
        <li class="flow-node" data-when="link=desktop,paired">
            <span class="flow-icon" set:html={icon.laptop} />
            <span class="flow-name">Track N Race</span>
            <span class="flow-detail">on <span data-fill="host-name">your computer</span></span>
        </li>
        <li class="flow-link" data-when="link=paired">
            <span class="flow-link-label">Paired</span>
            <span class="flow-link-detail">encrypted, over Wi-Fi</span>
        </li>
        <li class="flow-node" data-when="link=direct,paired">
            <span class="flow-icon" set:html={icon.phone} />
            <span class="flow-name">Track N Race</span>
            <span class="flow-detail">
                for Android
                <span data-when="link=direct">· Direct</span>
                <span data-when="link=paired">· Paired</span>
            </span>
        </li>
    </ol>

    <p class="mode-explainer" data-when="link=direct">
        <strong>Direct mode:</strong> the game sends its telemetry straight to your phone, and the phone
        decodes and records it itself. No computer involved.
    </p>
    <p class="mode-explainer" data-when="link=paired">
        <strong>Paired mode:</strong> the game talks only to your computer. The phone connects to the
        desktop app and shows what it shows, live or during playback of a recording, so you never have to
        change the game's settings to switch screens.
    </p>
    <p class="mode-explainer" data-when="link=direct">
        Want a computer in the loop as well? Pick <button class="text-btn" type="button" data-answer="view=both">computer and Android</button> to use Paired mode instead.
    </p>

    <div class="setup-flow">
        <!-- Opening it the first time, for the computer's OS -->
        <FirstLaunch when="os" />

        <!-- Everything to set, as one list to tick off: grouped by device, in the order it's done -->
        <div class="setup-step-card result-step" data-step="checklist">
            <div class="setup-step-card-header">
                <div class="setup-step-title-group">
                    <div class="setup-step-badge">02</div>
                    <h3 class="setup-step-title">Pre-race checklist</h3>
                </div>
            </div>
            <div class="checklist" data-checklist>
                <div class="checklist-progress">
                    <div class="checklist-bar"><i data-check-bar></i></div>
                    <span data-check-count>0 of 0</span>
                </div>

                <!-- Android, Direct mode: the phone does it all -->
                <p class="check-group" data-when="link=direct"><Fragment set:html={icon.phone} />On your phone: Track N Race</p>
                <CheckItem id="ck-d-open" when="link=direct">
                    <Fragment slot="title">Open Track N Race and allow Nearby devices</Fragment>
                    <Fragment slot="sub">Without it the app can't hear the game</Fragment>
                    <p class="step-desc">Android 17 and later ask on first launch. Missed it? Open Android's <strong>Settings</strong> &rarr; <strong>Apps</strong> &rarr; <strong>Track N Race</strong> &rarr; <strong>Permissions</strong> and allow <strong>Nearby devices</strong>.</p>
                </CheckItem>
                <CheckItem id="ck-d-source" when="link=direct">
                    <Fragment slot="title">Check the source is Direct UDP</Fragment>
                    <Fragment slot="sub">It's the default</Fragment>
                    <p class="step-desc">Open <strong>Settings</strong> &rarr; <strong>Telemetry</strong> &rarr; <strong>Source</strong> and choose <strong>Direct UDP</strong>.</p>
                </CheckItem>
                <CheckItem id="ck-d-addr" when="link=direct">
                    <Fragment slot="title">Copy the phone's address</Fragment>
                    <Fragment slot="sub">Tap the menu button. It shows after Direct UDP</Fragment>
                    <p class="step-desc">Tap the <strong>menu</strong> button in the top bar. The source line shows the phone's address after <strong>Direct UDP</strong>.</p>
                    <p class="step-desc">The phone has to be on the same Wi-Fi as <span data-fill="platform-name">your device</span>, with any VPN turned off.</p>
                </CheckItem>
                <CheckItem id="ck-d-rec" when="link=direct">
                    <Fragment slot="title">Turn on recording</Fragment>
                    <Fragment slot="sub">Optional. Saves every session as a .tnrd file to replay and analyse</Fragment>
                    <p class="step-desc">Open <strong>Settings</strong> &rarr; <strong>Recording</strong> and turn on <strong>Record sessions</strong>. Recordings go to the app's Documents folder, in <code>Track N Race</code>. To use another folder, tap <strong>Recording folder</strong>.</p>
                    <p class="step-desc">To watch one back, tap the <strong>menu</strong> button &rarr; <strong>Open recording</strong>.</p>
                </CheckItem>

                <!-- On the computer: first-time setup covers most of these -->
                <p class="check-group" data-when="link=desktop,paired"><Fragment set:html={icon.laptop} />On <span data-fill="host-name">your computer</span>: Track N Race</p>
                <CheckItem id="ck-open" when="link=desktop,paired">
                    <Fragment slot="title">Open Track N Race</Fragment>
                    <Fragment slot="sub">First-time setup starts by itself</Fragment>
                    <p class="step-desc">It walks you through most of this list. Every step has <strong>Skip</strong>, and everything can be changed later in <strong>Settings</strong>.</p>
                </CheckItem>
                <CheckItem id="ck-rec" when="link=desktop,paired">
                    <Fragment slot="title">Turn on recording</Fragment>
                    <Fragment slot="sub">Optional. Saves every session as a .tnrd file to replay and analyse</Fragment>
                    <p class="step-desc">First-time setup asks first: turn on <strong>Record Session Data</strong> and pick a folder.</p>
                    <ul class="info-box-checklist">
                        <li><strong>Electron, later:</strong> <strong>Settings</strong> &rarr; <strong>Data Storage</strong>, turn on <strong>Record Session Data</strong>, then <strong>Browse</strong> for a folder.</li>
                        <li data-when="native=yes"><strong>Native, later:</strong> <strong>Settings</strong> &rarr; <strong>Recording</strong>, tick <strong>Start recording when a session starts</strong>, then <strong>Change…</strong> the folder.</li>
                        <li><strong>Drivers to save:</strong> <strong>All Drivers</strong> keeps every car, so you can compare against anyone. <strong>Driver Only</strong> keeps just yours, in smaller files.</li>
                        <li data-when="link=paired"><strong>Paired mode:</strong> the computer records. The phone doesn't save a second copy.</li>
                    </ul>
                </CheckItem>
                <CheckItem id="ck-addr" when="ip=windows,macos,linux">
                    <Fragment slot="title">Copy <span data-fill="ip-owner">its</span> address</Fragment>
                    <Fragment slot="sub">Track N Race shows it under This PC's address</Fragment>
                    <p class="step-desc">First-time setup's <strong>Connect the game</strong> step shows it, ticked and marked <strong>Console or another PC</strong>. Click <strong>Copy</strong> beside it.</p>
                    <p class="step-desc">Later, it's in <strong>Settings</strong> &rarr; <strong>Network</strong><span data-when="native=yes"> in Electron, or <strong>Settings</strong> &rarr; <strong>Connection</strong> in Native</span>. VPN and virtual machine adapters are hidden, so they don't get picked by mistake.</p>
                    <details class="fix-fold">
                        <summary>Find it without the app</summary>
                        <div class="fix-fold-body">
                            <div data-when="ip=windows"><AddressMethods os="windows" /></div>
                            <div data-when="ip=macos"><AddressMethods os="macos" /></div>
                            <div data-when="ip=linux"><AddressMethods os="linux" /></div>
                        </div>
                    </details>
                </CheckItem>
                <CheckItem id="ck-loop" when="ip=loopback">
                    <Fragment slot="title">Pick "This PC only"</Fragment>
                    <Fragment slot="sub">The game sends to 127.0.0.1</Fragment>
                    <p class="step-desc">In first-time setup's <strong>Connect the game</strong> step, tick <strong>This PC only</strong>. The game and Track N Race are on the same PC, so nothing leaves it.</p>
                </CheckItem>
                <CheckItem id="ck-fw" when="fw=yes">
                    <Fragment slot="title">
                        <span data-when="os=windows">Allow it through Windows Firewall</span>
                        <span data-when="os=macos">Allow incoming connections</span>
                        <span data-when="os=linux">Open port 20777 in your firewall</span>
                    </Fragment>
                    <Fragment slot="sub">
                        <span data-when="os=windows">Check connection shows Allowed</span>
                        <span data-when="os=macos,linux">Only if your firewall is on</span>
                    </Fragment>
                    <div data-when="os=windows"><FirewallFix os="windows" /></div>
                    <div data-when="os=macos"><FirewallFix os="macos" /></div>
                    <div data-when="os=linux"><FirewallFix os="linux" /></div>
                </CheckItem>
                <CheckItem id="ck-pair" when="link=paired">
                    <Fragment slot="title">Pair your phone</Fragment>
                    <Fragment slot="sub">You only pair once</Fragment>
                    <div class="device-steps">
                        <div class="device-col">
                            <p class="device-col-title"><Fragment set:html={icon.laptop} /> On <span data-fill="host-name">your computer</span></p>
                            <ol class="task-list">
                                <li>Open <strong>Settings</strong> &rarr; <strong>Paired Devices</strong>.</li>
                                <li data-when="os=macos">Turn on <strong>Allow keychain access</strong> and restart the app. macOS then asks for your login password, because the app isn't signed with an Apple certificate.</li>
                                <li>Turn on <strong>Enable paired mode</strong>.</li>
                                <li>Click <strong>Pair a device</strong>. A QR code and an 8-character code appear for two minutes.</li>
                            </ol>
                        </div>
                        <div class="device-col">
                            <p class="device-col-title"><Fragment set:html={icon.phone} /> On your phone</p>
                            <ol class="task-list">
                                <li>Open Track N Race. Allow <strong>Nearby devices</strong> if asked: without it the app can't find the desktop.</li>
                                <li>Open <strong>Settings</strong> &rarr; <strong>Telemetry</strong> &rarr; <strong>Pair a desktop</strong>.</li>
                                <li>Tap <strong>Scan desktop QR</strong> and point it at the screen. Or pick your computer under <strong>Nearby desktops</strong> and type the code.</li>
                            </ol>
                        </div>
                        <div class="device-col device-col-wide">
                            <p class="device-col-title"><Fragment set:html={icon.both} /> To finish</p>
                            <ol class="task-list">
                                <li>The desktop asks <strong>Allow &lt;your phone&gt;?</strong> Click <strong>Allow</strong>.</li>
                                <li>The phone shows whatever the desktop shows, live or in playback.</li>
                            </ol>
                        </div>
                    </div>
                    <p class="step-callout" data-when="os=windows,linux">
                        <Fragment set:html={icon.info} />
                        <span>First-time setup's Paired mode step does all of this in one place.</span>
                    </p>
                </CheckItem>

                <!-- In the game -->
                <p class="check-group">
                    <Fragment set:html={icon.gamepad} />
                    <span data-when="platform=console">On your console:</span><span data-when="platform=pc">In</span>
                    <span data-fill="game-name">the game</span> &rarr; Settings &rarr; Telemetry Settings
                </p>
                <CheckItem id="ck-g-on">
                    <Fragment slot="title">UDP Telemetry</Fragment>
                    <Fragment slot="value"><span class="code-pill green">On</span></Fragment>
                </CheckItem>
                <CheckItem id="ck-g-broadcast">
                    <Fragment slot="title">UDP Broadcast Mode</Fragment>
                    <Fragment slot="sub">Sends to one address instead of the whole network</Fragment>
                    <Fragment slot="value"><span class="code-pill">Off</span></Fragment>
                </CheckItem>
                <CheckItem id="ck-g-ip">
                    <Fragment slot="title">UDP IP Address</Fragment>
                    <Fragment slot="sub">
                        <span data-when="ip=loopback">Means "this same PC"</span>
                        <span data-when="ip=windows,macos,linux">The address you copied from Track N Race</span>
                        <span data-when="ip=android">The phone's address, from the app's menu</span>
                    </Fragment>
                    <Fragment slot="value"><span class="code-pill green" id="ipPill" data-fill="ip-target">127.0.0.1</span></Fragment>
                </CheckItem>
                <CheckItem id="ck-g-port">
                    <Fragment slot="title">UDP Port</Fragment>
                    <Fragment slot="sub">
                        <span data-when="link=desktop,paired">Track N Race's default, unless you changed it in its Settings</span>
                        <span data-when="link=direct">Track N Race's default, unless you changed it in Settings &rarr; Telemetry &rarr; UDP listener</span>
                    </Fragment>
                    <Fragment slot="value"><span class="code-pill">20777</span></Fragment>
                </CheckItem>
                <CheckItem id="ck-g-rate">
                    <Fragment slot="title">UDP Send Rate</Fragment>
                    <Fragment slot="sub">Any of these works. 60Hz is the smoothest. Drop to 20–30Hz if the Wi-Fi struggles</Fragment>
                    <Fragment slot="value">
                        <span class="code-pill">10Hz</span>
                        <span class="code-pill">20Hz</span>
                        <span class="code-pill">30Hz</span>
                        <span class="code-pill green">60Hz</span>
                    </Fragment>
                </CheckItem>
                <CheckItem id="ck-g-format">
                    <Fragment slot="title">UDP Format</Fragment>
                    <Fragment slot="sub">
                        <span data-when="game=f124">The only format Track N Race reads from F1 24. 2022 and 2023 aren't supported</span>
                        <span data-when="game=f125">Either works. 2025 has the most data</span>
                        <span data-when="game=f126">Any of these works. 2026 has the newest data; older formats miss it</span>
                    </Fragment>
                    <Fragment slot="value">
                        <span class="code-pill" data-when="game=f125,f126">2024</span>
                        <span class="code-pill green" data-when="game=f124">2024</span>
                        <span class="code-pill" data-when="game=f126">2025</span>
                        <span class="code-pill green" data-when="game=f125">2025</span>
                        <span class="code-pill green" data-when="game=f126">2026</span>
                    </Fragment>
                </CheckItem>

                <!-- Go -->
                <p class="check-group"><Fragment set:html={icon.flag} />Go</p>
                <CheckItem id="ck-drive">
                    <Fragment slot="title">Start a session and drive out</Fragment>
                    <Fragment slot="sub">
                        <span data-when="link=desktop,paired">Check connection turns to Receiving</span>
                        <span data-when="link=direct">Leave Track N Race running</span>
                    </Fragment>
                    <p class="step-desc">The game only sends telemetry on track or in the garage, not from the menus. The dashboard fills in within a second.</p>
                    <p class="step-desc" data-when="link=direct">The listener keeps running in the background, even with the screen off. It only stops when you stop it from its notification or close the app from the Recents menu.</p>
                </CheckItem>
            </div>
        </div>

        <!-- Optional: passing the game's data on to a wheel or another telemetry app (UDP forwarding) -->
        <div class="setup-step-card result-step" data-step="forwarding">
            <div class="setup-step-card-header">
                <div class="setup-step-title-group">
                    <div class="setup-step-badge">03</div>
                    <h3 class="setup-step-title">Other telemetry apps</h3>
                </div>
            </div>
            <p class="mode-explainer">
                <strong>UDP forwarding:</strong> the game sends its telemetry to one address and one port, so only
                one app gets it. To use Track N Race with your wheel or another telemetry app, have the game send to
                Track N Race, and turn on forwarding. Track N Race then sends a copy of every packet, exactly as the
                game sent it, to up to 15 other apps. Only using Track N Race? Skip this step.
            </p>

            <ol class="flow-diagram" aria-label="How forwarded telemetry travels">
                <li class="flow-node">
                    <span class="flow-icon" set:html={icon.gamepad} />
                    <span class="flow-name"><span data-fill="game-name">F1</span></span>
                    <span class="flow-detail">sends once</span>
                </li>
                <li class="flow-link">
                    <span class="flow-link-label">UDP · 20777</span>
                </li>
                <li class="flow-node">
                    <span class="flow-icon" set:html={icon.laptop} data-when="link=desktop,paired" />
                    <span class="flow-icon" set:html={icon.phone} data-when="link=direct" />
                    <span class="flow-name">Track N Race</span>
                    <span class="flow-detail">receives and forwards</span>
                </li>
                <li class="flow-link">
                    <span class="flow-link-label">Forwarded</span>
                    <span class="flow-link-detail">unchanged</span>
                </li>
                <li class="flow-node">
                    <span class="flow-icon" set:html={icon.monitor} />
                    <span class="flow-name">Your other apps</span>
                    <span class="flow-detail">up to 15</span>
                </li>
            </ol>

            <h4 class="record-subtitle">When you need it</h4>
            <ul class="info-box-checklist">
                <li><strong>A wheel, dash or motion rig:</strong> its software reads the game's telemetry for rev lights, the wheel's display or effects. Forward to it, and it keeps working while Track N Race runs.</li>
                <li><strong>You already use another telemetry app:</strong> point the game at Track N Race and forward to that app, on this <span data-when="link=desktop,paired">computer</span><span data-when="link=direct">phone</span> or another device. If the other app can forward too, you can do it the other way round: leave the game pointed at it, and forward from it to Track N Race.</li>
            </ul>

            <h4 class="record-subtitle">Turn it on</h4>
            <div data-when="link=desktop,paired"><ForwardSteps apps={['electron', 'native', 'minimal', 'android']} /></div>
            <div data-when="link=direct"><ForwardSteps apps={['android', 'electron', 'native', 'minimal']} /></div>

            <h4 class="record-subtitle">Pick the address and port</h4>
            <ForwardPorts />
            <p class="fix-caption">Only live data is forwarded. Playing back a recording doesn't send anything to other apps.</p>
        </div>

        <!-- The problems most likely for this setup, then the rest of the Troubleshooting page -->
        <div class="setup-step-card result-step" data-step="troubleshooting">
            <div class="setup-step-card-header">
                <div class="setup-step-title-group">
                    <div class="setup-step-badge">04</div>
                    <h3 class="setup-step-title">Troubleshooting</h3>
                </div>
            </div>
            <div class="fix-links">
                <a href="/troubleshooting/#fix-game" data-fix-link>The game isn't sending anything</a>
                <a href="/troubleshooting/#fix-fw-windows" data-fix-link data-when="fw=yes os=windows">Windows Firewall is blocking Track N Race</a>
                <a href="/troubleshooting/#fix-fw-mac" data-fix-link data-when="fw=yes os=macos">The macOS firewall is blocking Track N Race</a>
                <a href="/troubleshooting/#fix-fw-linux" data-fix-link data-when="fw=yes os=linux">Your Linux firewall is blocking port 20777</a>
                <a href="/troubleshooting/#fix-address" data-fix-link data-when="ip=windows,macos,linux">The game is sending to the wrong address</a>
                <a href="/troubleshooting/#fix-nearby" data-fix-link data-when="link=direct">Android hasn't let Track N Race listen</a>
                <a href="/troubleshooting/#fix-not-found" data-fix-link data-when="link=paired">The phone can't find the desktop</a>
                <a href="/troubleshooting/#fix-ap-isolation" data-fix-link data-when="ip=windows,macos,linux,android">Your router keeps devices apart</a>
                <a href="/troubleshooting/#fix-port-shared" data-fix-link>Your wheel or other app stopped getting data</a>
            </div>
            <a class="secondary-btn fix-all" href="/troubleshooting/" data-fix-link data-astro-prefetch>All troubleshooting</a>
        </div>
    </div>
</section>
