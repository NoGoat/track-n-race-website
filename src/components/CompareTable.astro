---
// The Frontends page's features table, grouped by what the features are for. Styles in styles/compare.css.
import { builds, shortNames, features } from '../data/compare';
---
<div class="cmp-table-scroll" tabindex="0">
    <table class="cmp-table">
        <thead>
            <tr>
                <th scope="col"><span class="visually-hidden">Feature</span></th>
                {builds.map(build => <th scope="col" data-f={build}><i class="cmp-dot"></i>{shortNames[build]}</th>)}
            </tr>
        </thead>
        <tbody>
            {features.map(group => (
                <Fragment>
                    <tr class="cmp-group"><th colspan={builds.length + 1} scope="colgroup">{group.group}</th></tr>
                    {group.rows.map(([label, values]) => (
                        <tr>
                            <th scope="row">{label}</th>
                            {values.map(v => v === null ? <td class="na">—</td> : v ? <td class="yes">Yes</td> : <td class="no">No</td>)}
                        </tr>
                    ))}
                </Fragment>
            ))}
        </tbody>
    </table>
</div>
